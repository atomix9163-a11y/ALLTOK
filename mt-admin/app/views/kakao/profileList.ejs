<%- contentFor('style') %>
<link href="/assets/vendors/nice-select2/dist/css/nice-select2.css" rel="stylesheet" />

<%- contentFor('content') %>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-lg-4 col-sm-6">
                        <div class="search-box mb-2 me-2 d-none">
                            <div class="position-relative">
                                <input type="text" class="form-control bg-light border-light rounded" placeholder="Search...">
                                <i class="search-icon" data-eva="search-outline" data-eva-height="26" data-eva-width="26"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8 col-sm-6">
                        <div class="mt-4 mt-sm-0 d-flex align-items-center justify-content-sm-end">
                            <div class="mb-2 me-2">
                                <div class="dropdown">
                                    <button  class="btn btn-warning" type="button" onclick="openNewForceModal()">
                                        <i class="mdi mdi-plus me-1"></i> 새 프로파일 임의 추가
                                    </button>
                                </div>
                            </div>
                            <div class="mb-2 me-2">
                                <div class="dropdown">
                                    <button  class="btn btn-primary" type="button" onclick="openNewModal()">
                                        <i class="mdi mdi-plus me-1"></i> 새 프로파일 추가
                                    </button>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>

                <h5 class="font-size-16 me-3 mb-0">프로파일 목록</h5>
                    <hr class="mt-2">
                    <div class="table-responsive mb-5">
                        <table class="table align-middle table-nowrap table-hover mb-0">
                            <thead class="">
                                <tr>
                                  <th scope="col">가맹점코드</th>
                                  <th scope="col">가맹점명</th>
                                  <th scope="col">채널아이디</th>
                                  <th scope="col">채널명</th>
                                  <th scope="col">프로파일 키</th>
                                  <th scope="col">상태</th>
                                  <th scope="col">등록일</th>
                                  <th scope="col">변경일</th>
                                  <th scope="col"></th>
                                </tr>
                              </thead>
                            <tbody id="profile-list">
                            </tbody>
                        </table>
                    </div>
                    
                    <nav aria-label="Page navigation example">
                        <ul class="pagination justify-content-center" id="profile-pager"></ul>
                    </nav>
            </div>
        </div>

    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modal-profile" tabindex="-1"aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_userView_Label"> 카카오 프로파일 관리</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="user-seq">
                <div class="text-center mb-4">
                    <h5>카카오 프로파일 등록</h5>
                    <p class="card-title-desc">MTS 컴퍼니 API 용</p>
                </div>
                <div>
                    <div class="row mb-3">
                        <label for="colFormLabelSm" class="col-sm-2 col-form-label col-form-label">가맹점</label>
                        <div class="col-sm-4">
                            <select class="" name="store-code" id="store-code">
                            </select>      
                        </div>  
                    </div>
                    <div class="row mb-3">
                        <label for="channel-id" class="col-sm-2 col-form-label col-form-label">채널아이디</label>
                        <div class="col-sm-4">
                            <input type="text" class="form-control" placeholder="@을 제외하고 입력하세요" id="channel-id" name="channel-id">
                        </div>
                    </div>                    
                    <div class="row mb-3">
                        <label for="category-1st" class="col-sm-2 col-form-label col-form-label">카테고리</label>
                        <div class="col-sm-4">
                            <select class="form-select" id="category-1st" onchange="set2ndCategory(this)"></select>
                        </div>
                        <div class="col-sm-3">
                            <select class="form-select" id="category-2nd" onchange="set3rdCategory(this)"></select>
                        </div>
                        <div class="col-sm-3">
                            <select class="form-select" id="category-3rd"></select>
                        </div>
                        
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label col-form-label" for="channel-phone">채널 관리자</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control mb-2" placeholder="휴대폰 번호" id="channel-phone" name="channel-phone">
                        </div>
                        <div class="col-sm-2">
                            <button type="button" class="btn btn-warning waves-effect waves-light" onclick="sendToken()">인증번호발송</button>
                        </div>                        
                    </div>                    
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label col-form-label" for="token">인증번호</label>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" placeholder="인증 번호" id="token" name="token">
                        </div>
                    </div>   
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary waves-effect waves-light" onclick="saveProfile()">저장하기</button>
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<!-- Modal -->
<div class="modal fade" id="modal-profileForce" tabindex="-1"aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_userView_Label"> 카카오 프로파일 관리</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="user-seq">
                <div class="text-center mb-4">
                    <h5>카카오 프로파일 등록</h5>
                    <p class="card-title-desc">MTS 컴퍼니 프로파일 임의 추가</p>
                </div>
                <div>
                    <div class="row mb-3">
                        <label for="colFormLabelSm" class="col-sm-2 col-form-label col-form-label">가맹점</label>
                        <div class="col-sm-4">
                            <select class="" name="store-code-force" id="store-code-force">
                            </select>      
                        </div>  
                    </div>
                    <div class="row mb-3">
                        <label for="channel-id" class="col-sm-2 col-form-label col-form-label">채널아이디</label>
                        <div class="col-sm-4">
                            <input type="text" class="form-control" placeholder="@을 제외하고 입력하세요" id="channel-id-force" name="channel-id-force">
                        </div>
                    </div>                    
                    <div class="row mb-3">
                        <label for="category-1st-force" class="col-sm-2 col-form-label col-form-label">카테고리</label>
                        <div class="col-sm-4">
                            <select class="form-select" id="category-1st-force" onchange="set2ndCategoryForce(this)"></select>
                        </div>
                        <div class="col-sm-3">
                            <select class="form-select" id="category-2nd-force" onchange="set3rdCategoryForce(this)"></select>
                        </div>
                        <div class="col-sm-3">
                            <select class="form-select" id="category-3rd-force"></select>
                        </div>                        
                    </div>
                    <div class="row mb-3">
                        <label for="channel-id" class="col-sm-2 col-form-label col-form-label">프로파일키</label>
                        <div class="col-sm-4">
                            <input type="text" class="form-control" placeholder="프로파일 키를 입력하세요" id="profile-key-force" name="profile-key-force">
                        </div>
                    </div>                    

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary waves-effect waves-light" onclick="saveProfileForce()">저장하기</button>
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<%- contentFor('script') %>

<script src="/assets/vendors/nice-select2/dist/js/nice-select2.js"></script>
<script>
    const apiServer = '<%=apiServer %>';
    let currentPage = 1;
    const rowPerPage = 20;
    let category = null;

    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        await showList();
        // 신규 등록용 마트 목록 얻기
        getMartList();
        getCategory();
    })

    const getMartList = () => {
        let callApi = `${apiServer}/store/apiList`;
        const result = axios.post(callApi, {
            page: 1,
            rowCount: 200,
            searchKey: ""
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => { 
            console.log(response.data)
            let optionHTML = "<option value=''>선택하세요</option>";
            if (response.data.data.count > 0) {
                for (let storeInfo of response.data.data.rows) {
                    optionHTML += `<option value="${storeInfo.store_code}">${storeInfo.store_code} ${storeInfo.name}</option>`;
                    // console.log(storeInfo)
                }
            }
            document.getElementById("store-code").innerHTML = optionHTML;
            NiceSelect.bind(document.getElementById("store-code"), {searchable: true})
            document.getElementById("store-code-force").innerHTML = optionHTML;
            NiceSelect.bind(document.getElementById("store-code-force"), {searchable: true})
        })
    }

    const getCategory = () => {
        console.log(0)
        let callApi = `/api/profile/categoryList`;
        const result = axios.post(callApi, {
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {  
            console.log(response)
            // category data를 보관
            category = response.data.data.tree;
            // 카테고리 1번에만 데이터를 입력
            let optionHTML = `<option value=''>선택하세요</option>`;
            for (let category of response.data.data.tree) {
                optionHTML += `<option value='${category.code}'>${category.name}</option>`;
            }
            document.getElementById("category-1st").innerHTML = optionHTML;
            document.getElementById("category-2nd").innerHTML = "<option value=''>선택하세요</option>";
            document.getElementById("category-3rd").innerHTML = "<option value=''>선택하세요</option>";

            document.getElementById("category-1st-force").innerHTML = optionHTML;
            document.getElementById("category-2nd-force").innerHTML = "<option value=''>선택하세요</option>";
            document.getElementById("category-3rd-force").innerHTML = "<option value=''>선택하세요</option>";
        }).catch(e => {
            console.log(e)
        })
        console.log(1)
    }

    const set2ndCategory = (obj) => {
        const selectCode = obj.value;
        // console.log(selectCode)
        // 대상 데이터를 얻는다

        const selectedCategory = (category.find(e => e.code == selectCode)).category;
        
        let optionHTML = `<option value=''>선택하세요</option>`;
        for (let category of selectedCategory) {
            optionHTML += `<option value='${category.code}'>${category.name}</option>`;
        }
        document.getElementById("category-2nd").innerHTML = optionHTML;
        document.getElementById("category-3rd").innerHTML = "<option value=''>선택하세요</option>";
    }

    const set2ndCategoryForce = (obj) => {
        const selectCode = obj.value;
        // console.log(selectCode)
        // 대상 데이터를 얻는다

        const selectedCategory = (category.find(e => e.code == selectCode)).category;
        
        let optionHTML = `<option value=''>선택하세요</option>`;
        for (let category of selectedCategory) {
            optionHTML += `<option value='${category.code}'>${category.name}</option>`;
        }
        document.getElementById("category-2nd-force").innerHTML = optionHTML;
        document.getElementById("category-3rd-force").innerHTML = "<option value=''>선택하세요</option>";
    }

    const set3rdCategory = (obj) => {
        const selectCode = obj.value;

        // 대상 데이터를 얻는다
        // 현재 선택된 1차 코드를 얻는다
        const firstCode = document.getElementById("category-1st").value;
        const secondCode = document.getElementById("category-2nd").value;

        // 현재 선택된 2차 코드를 얻는다
        const selectedCategory = (category.find(e => e.code == firstCode)).category.find(e => e.code == secondCode).category;
        
        let optionHTML = `<option value=''>선택하세요</option>`;
        for (let category of selectedCategory) {
            optionHTML += `<option value='${category.fullCode}'>${category.name}</option>`;
        }
        document.getElementById("category-3rd").innerHTML = optionHTML;
    }

    const set3rdCategoryForce = (obj) => {
        const selectCode = obj.value;

        // 대상 데이터를 얻는다
        // 현재 선택된 1차 코드를 얻는다
        const firstCode = document.getElementById("category-1st-force").value;
        const secondCode = document.getElementById("category-2nd-force").value;

        // 현재 선택된 2차 코드를 얻는다
        const selectedCategory = (category.find(e => e.code == firstCode)).category.find(e => e.code == secondCode).category;
        
        let optionHTML = `<option value=''>선택하세요</option>`;
        for (let category of selectedCategory) {
            optionHTML += `<option value='${category.fullCode}'>${category.name}</option>`;
        }
        document.getElementById("category-3rd-force").innerHTML = optionHTML;
    }

    // 사용자 리스트 뷰
    const showList = () => {
        let callApi = `/api/profile/list`;
        const result = axios.post(callApi, {
            page: currentPage,
            rowCount: rowPerPage
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {  
            console.log(response)
            let html = "";
            if (response.data.result && response.data.data) {
                for (let item of response.data.data.rows) {
                    html += `<tr>
                                <td>${item.store_code}</td>
                                <td>${item.name}</td>
                                <td>@${item.channel_id}</td>
                                <td>${item.channel_name}</td>
                                <td>${item.profile_key}</td>
                                <td>
                                    ${(item.status == 'A') ? 
                                    '<span class="badge bg-success rounded-pill"> 정상 </span>' : 
                                    (item.active == 'C') ? '<span class="badge bg-warning rounded-pill"> 휴면 </span>' : 
                                    (item.active == 'B') ? '<span class="badge bg-warning rounded-pill"> 차단 </span>' : 
                                    (item.active == 'E') ? '<span class="badge bg-warning rounded-pill"> 삭제 중 </span>' : 
                                    '<span class="badge bg-danger rounded-pill"> 삭제됨 </span>' }
                                </td>                                
                                <td>${moment(item.C_TIME).format("YYYY/MM/DD HH:mm:ss")}</td>
                                <td>${item.M_TIME ? moment(item.M_TIME).format("YYYY/MM/DD HH:mm:ss") : ''}</td>
                                <td>
                                    <button type="button" class="btn btn-sm font-20 btn-primary" onclick="deleteProfile('${item.store_code}', '${item.channel_id}')">삭제</button>
                                </td>
                            </tr>`;                                
                }
                let pagerHTML = createPagerHTML(response.data.data.count, rowPerPage, currentPage, 5, "changePage");
                document.getElementById("profile-pager").innerHTML = pagerHTML;
            } else {
                document.getElementById("profile-pager").innerHTML = "";
            }
            document.getElementById("profile-list").innerHTML = html;


        }).catch(error => {

        })
    }

    const changePage = async (page, rowPerPage) => {
        currentPage = page;
        await showList()
    }

    const sendToken = () => {
        let yellowId = document.getElementById("channel-id").value.trim();        
        let phoneNumber = document.getElementById("channel-phone").value.trim();

        if (yellowId.length == 0 || phoneNumber.length == 0) {
            alert("채널 아이디와 채널 관리자 번호는 반드시 입력해야 합니다.");
            return;
        }

        let callApi = `/api/profile/sendToken`;
        const result = axios.post(callApi, {
            yellowId: yellowId,
            phoneNumber: phoneNumber,
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {  
            console.log(response.data)
            if (response.data.data.code == "200") {
                alert("입력한 전화번호로 발송된 OTP 인증번호를 확인하여 주세요.");
            } else {
                alert(response.data.data.message);
            }
        })
    }

    // 새로 등록            
    const openNewModal = () => {
        document.getElementById("store-code").value = "";
        document.getElementById("channel-id").value = "";
        document.getElementById("category-1st").value = "";
        document.getElementById("category-2nd").value = "";
        document.getElementById("category-3rd").value = "";
        document.getElementById("channel-phone").value = "";
        document.getElementById("token").value = "";

        const modal = new bootstrap.Modal(document.getElementById('modal-profile'));
        modal.show();
    }

    // 프로파일 체크하지 않고 임의로 등록
    const openNewForceModal = () => {
        document.getElementById("store-code").value = "";
        document.getElementById("channel-id").value = "";
        document.getElementById("category-1st").value = "";
        document.getElementById("category-2nd").value = "";
        document.getElementById("category-3rd").value = "";
        document.getElementById("channel-phone").value = "";
        document.getElementById("token").value = "";

        const modal = new bootstrap.Modal(document.getElementById('modal-profileForce'));
        modal.show();
    }

    const validation = (storeCode, yellowId, categoryCode, phoneNumber, token, isForce = false) => {
        if (storeCode.length == 0) {
            alert("가맹점을 선택해야만 합니다.");
            return false;
        }
        if (yellowId.length == 0) {
            alert("채널 아이디를 입력해야만 합니다.");
            return false;
        }
        if (categoryCode.length == 0) {
            alert("상세 카테고리까지 모두 선택해야만 합니다.");
            return false;
        }
        if (isForce) return true;
        if (phoneNumber.length == 0) {
            alert("체널 관리자 전화번호를 입력하고 인증번호를 받아야만 합니다.");
            return false;
        }
        if (token.length == 0) {
            alert("체널 관리자 전화번호를 입력하고 인증번호를 받아야만 합니다.");
            return false;
        }
        return true;
    }

    const saveProfile = async () => {
        let storeCode = document.getElementById("store-code").value;
        let yellowId = document.getElementById("channel-id").value.trim();
        let categoryCode = document.getElementById("category-3rd").value;
        let categoryName = document.getElementById("category-1st").options[document.getElementById("category-1st").selectedIndex].text + "," + 
                document.getElementById("category-2nd").options[document.getElementById("category-2nd").selectedIndex].text + "," + 
                document.getElementById("category-3rd").options[document.getElementById("category-3rd").selectedIndex].text;
        let phoneNumber = document.getElementById("channel-phone").value;
        let token = document.getElementById("token").value.trim();

        if (!validation(storeCode, yellowId, categoryCode, phoneNumber, token)) return;

        // if (!confirm(`사용자 정보가 ${(seq == "") ? "추가" : "변경"}됩니다. 계속하시겠습니까?`)) return;

        let callApi = `${apiServer}/kakao/apiProfileAdd`;
        // 정보를 업데이트        
        await axios.post(callApi, {
            storeCode: storeCode,
            yellowId: yellowId,
            categoryCode: categoryCode,
            categoryName: categoryName,
            phoneNumber: phoneNumber,
            token: token
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(async response => {
            console.log(response)
            if (response.data.result) {
                if (response.data.data.code == 509) {
                    alert(response.data.data.message);
                } else {
                    let modal = bootstrap.Modal.getInstance(document.getElementById('modal-profile'));
                    modal.hide();

                    alert(`프로파일이 등록되었습니다.`);
                    await showList();
                }
            } else {
                alert(response.data.data.message);
            }
        })
        .catch(error => { console.log(error); alert(`프로파일을 등록하지 못했습니다.`);});
    }

    // 프로파일 사용 가능 여부를 체크하지 않고 디비에 등록하여 사용할 수 있도록 함
    const saveProfileForce = async () => {
        let storeCode = document.getElementById("store-code-force").value;
        let yellowId = document.getElementById("channel-id-force").value.trim();
        let categoryCode = document.getElementById("category-3rd-force").value;
        let categoryName = document.getElementById("category-1st-force").options[document.getElementById("category-1st-force").selectedIndex].text + "," + 
                document.getElementById("category-2nd-force").options[document.getElementById("category-2nd-force").selectedIndex].text + "," + 
                document.getElementById("category-3rd-force").options[document.getElementById("category-3rd-force").selectedIndex].text;
        let profileKey = document.getElementById("profile-key-force").value;

        if (!validation(storeCode, yellowId, categoryCode, "", token, true)) return;

        // if (!confirm(`사용자 정보가 ${(seq == "") ? "추가" : "변경"}됩니다. 계속하시겠습니까?`)) return;

        let callApi = `${apiServer}/kakao/apiProfileAddForce`;
        // 정보를 업데이트                   
        await axios.post(callApi, {
            storeCode: storeCode,
            yellowId: yellowId,
            categoryCode: categoryCode,
            categoryName: categoryName,
            profileKey: profileKey
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(async response => {
            console.log(response)
            if (response.data.result) {
                let modal = bootstrap.Modal.getInstance(document.getElementById('modal-profileForce'));
                modal.hide();

                alert(`프로파일이 등록되었습니다.`);
                await showList();
            } else {
                alert("프로파일이 등록이 실패했습니다.");
            }
        })
        .catch(error => { console.log(error); alert(`프로파일을 등록하지 못했습니다.`);});
    }

    const deleteProfile = async (storeCode, yellowId) => {
        if (!confirm("프로파일 강제 삭제는 복구할 수 없습니다. 계속 하시겠습니까?")) return;
        let callApi = `${apiServer}/kakao/apiProfileRemove`;
        // 정보를 업데이트        
        await axios.post(callApi, {
            storeCode: storeCode,
            yellowId: yellowId
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(async response => {
            console.log(response)
            if (response.data.result) {
                alert(`프로파일이 삭제되었습니다.`);
                await showList();
            } else {
                alert(`프로파일을 삭제하지 못했습니다 (Database Error).`);
            }
        })
        .catch(error => { console.log(error); alert(`프로파일을 삭제하지 못했습니다 (Network Error).`);});
    }
</script>

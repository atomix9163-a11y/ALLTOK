<%- contentFor('style') %>

<%- contentFor('content') %>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-lg-4 col-sm-6">
                        <div class="search-box mb-2 me-2 d-none">
                            <div class="position-relative">
                                <input type="text" class="form-control bg-light border-light rounded" placeholder="Search...">
                                <i class="search-icon" data-eva="search-outline" data-eva-height="26" data-eva-width="26"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-8 col-sm-6">
                        <div class="mt-4 mt-sm-0 d-flex align-items-center justify-content-sm-end">

                            <div class="mb-2 me-2">
                                <div class="dropdown">
                                    <button id="btn-addUser" class="btn btn-primary dropdown-toggle" type="button" onclick="openNewModal()">
                                        <i class="mdi mdi-plus me-1"></i> 새 발신번호 추가
                                    </button>
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-5">
                    <table class="table align-middle table-nowrap table-hover mb-0">
                        <thead class="">
                            <tr>
                                <th scope="col">발신번호</th>
                                <th scope="col">설명</th>
                                <th scope="col">등록일</th>
                                <th scope="col"></th>
                            </tr>
                            </thead>
                        <tbody id="phone-list">
                        </tbody>
                    </table>
                </div>
                
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-center" id="phone-pager"></ul>
                </nav>
            </div>
        </div>

    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modal-phone" tabindex="-1"aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_userView_Label"> 발신번호 등록관리</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="user-seq">
                <div class="text-center mb-4">
                    <h5>발신번호 추가</h5>
                    <p class="card-title-desc">아래 내용을 입력하여 주세요</p>
                </div>
                <div>
                    <div class="row">
                        <div class="col-lg-3">
                            <div class="mb-3">
                                <label for="user-loginId" class="form-label">발신번호 :</label>
                                <input type="text" class="form-control" placeholder="발신번호를 입력하세요" id="phone" name="phone">
                            </div>
                            
                        </div>
                        <div class="col-lg-9">
                            <div class="mb-3">
                                <label for="user-name" class="form-label">설명 :</label>
                                <input type="text" class="form-control" placeholder="설명을 입력하세요" id="comment" name="comment">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary waves-effect waves-light" onclick="addPhone()">추가하기</button>
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<%- contentFor('script') %>
<script>
    let currentPage = 1;
    const rowPerPage = 20;

    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        await showList();
    })

    // 사용자 리스트 뷰
    const showList = () => {
        let callApi = `/api/phone/list`;
        const result = axios.post(callApi, {
            page: currentPage,
            rowCount: rowPerPage
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {  
            console.log(response)
            let html = "";
            if (response.data.result && response.data.data) {
                for (let item of response.data.data.rows) {
                    html += `<tr>
                                    <td>${item.phone}</td>
                                    <td>${item.comment}</td>
                                    <td>${moment(item.C_TIME).format("YYYY-MM-DD")}</td>
                                    <td>
                                        <button type="button" class="btn btn-sm font-20 btn-primary" onclick="removePhone('${item.seq}')">삭제</button>
                                    </td>
                                </tr>`;                                
                }
                let pagerHTML = createPagerHTML(response.data.data.count, rowPerPage, currentPage, 5, "changePage");
                document.getElementById("phone-pager").innerHTML = pagerHTML;
            } else {
                document.getElementById("phone-pager").innerHTML = "";
            }
            document.getElementById("phone-list").innerHTML = html;


        }).catch(error => {

        })
    }

    const changePage = async (page, rowPerPage) => {
        currentPage = page;
        await showList()
        // self.location.href = "/user/list?page=" + page;
    }

    // 새로 등록            
    const openNewModal = () => {
        document.getElementById("phone").value = "";
        document.getElementById("comment").value = "";

        const modal = new bootstrap.Modal(document.getElementById('modal-phone'));
        modal.show();
    }

    const validation = (phone) => {
        if (phone.length == 0) {
            alert("전화번호를 입력해야만 합니다.");
            return false;
        }
        return true;
    }

    const addPhone = async () => {
        let phone = document.getElementById("phone").value.trim();
        let comment = document.getElementById("comment").value.trim();

        if (!validation(phone)) return;

        // if (!confirm(`사용자 정보가 ${(seq == "") ? "추가" : "변경"}됩니다. 계속하시겠습니까?`)) return;

        let callApi = "/api/phone/create";
        // 정보를 업데이트        
        await postData(callApi, {
            phone: phone,
            comment: comment
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(async response => {
            if (response.result) {
                let modal = bootstrap.Modal.getInstance(document.getElementById('modal-phone'));
                modal.hide();

                await showList();
            } else {
                alert(`발신번호를 정보를 추가하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`발신번호를 정보를 추가하지 못했습니다.`);});
    }

    const removePhone = async (seq) => {
        let callApi = "/api/phone/remove";
        // 정보를 업데이트        
        await postData(callApi, {
            seq: seq
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(async response => {
            if (response.result) {
                await showList();
            } else {
                alert(`발신번호를 정보를 삭제하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`발신번호를 정보를 삭제하지 못했습니다.`);});
    }
</script>

<%- contentFor('style') %>

<%- contentFor('content') %>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-lg-3 col-sm-6">
                        <div class="search-box mb-2 me-2">
                            <div class="position-relative">
                                <input type="text" id="search-key" class="form-control form-control-sm border-light rounded" placeholder="Search..." value="">
                                <i class="search-icon" data-eva="search-outline" data-eva-height="26" data-eva-width="26"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-1">
                        <button id="search" class="fc-today-button btn btn-sm btn-primary" type="button" onclick="listStore(1)">검색</button>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-check form-check-inline">
                            <input id="rd-show-normal" class="form-check-input" type="radio" name="rd-show" value="A" checked="">
                            <label for="rd-show-normal" class="form-check-label">정상</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input id="rd-show-close" class="form-check-input" type="radio" name="rd-show" value="D">
                            <label for="rd-show-close" class="form-check-label">정지</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input id="rd-show-all" class="form-check-input" type="radio" name="rd-show" value="">
                            <label for="rd-show-all" class="form-check-label">전체</label>
                        </div>
                    </div>
                    <div class="col-lg-5 col-sm-6">
                        <div class="mt-4 mt-sm-0 d-flex align-items-center justify-content-sm-end">
                            <div class="mb-2 me-2">
                                <div class="dropdown">
                                    <button id="btn-store-add" class="btn btn-sm btn-primary" type="button" onclick="openAddStoreModal()" >
                                        <i class="mdi mdi-plus me-1"></i> 새 가맹점 추가
                                    </button>
                                    <input type="text" class="hidden-text">
                                </div>
                            </div>
                            
                        </div>
                    </div>
                </div>

                <h5 class="font-size-16 me-3 mb-0">가맹점 목록</h5>
                    <hr class="mt-2">
                    <div class="table-responsive mb-5">
                        <table class="table table-striped table-hover">
                            <thead class="">
                                <tr>
                                    <th scope="col">가맹점코드</th>
                                    <th scope="col">가맹점명</th>
                                    <th scope="col">연동서비스</th>
                                    <th scope="col">연동코드</th>
                                    <th scope="col">담당자</th>
                                    <th scope="col">대행</th>
                                    <th scope="col">서비스</th>
                                    <th scope="col">로그인아이디</th>
                                    <th scope="col">잔액</th>
                                    <th scope="col">상태</th>
                                    <th scope="col">등록일</th>
                                    <th scope="col" class="text-center">작업</th>
                                </tr>
                            </thead>
                            <tbody id="store-main">                            
                            </tbody>
                        </table>
                    </div>
                    
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center" id="store-pager"></ul>
                    </nav>
            </div>
        </div>

    </div>
</div>

<!-- 기본정보 Modal -->
<div class="modal fade" id="modal-store" tabindex="-1" aria-labelledby="modal_store_Label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> 가맹점 관리</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="store-code">
                <div class="row mb-3">
                    <div class="col-lg-4">
                        <label for="store-name" class="form-label">가맹점명 (*) :</label>
                        <input type="text" class="form-control" maxlength="45" placeholder="가맹점명를 입력하세요" id="store-name" name="store-name">
                    </div>
                    <div class="col-lg-2">
                        <label class="form-label">모바일웹 구분 :</label>
                        <select class="form-select" id="shop-type">
                            <option value="U">단독</option>
                            <option value="QU">큐마켓 단독</option>
                            <option value="Q">큐마켓 연동</option>
                            <option value="L">슈켓 연동</option>
                        </select>
                    </div>
                    <div class="col-lg-3">
                        <label for="store-name" class="form-label">M CODE :</label>
                        <input type="text" class="form-control" maxlength="10" placeholder="MOA CODE를 입력하세요" id="m-code" name="m-code">
                    </div>
                    <div class="col-lg-3">
                        <label for="store-name" class="form-label">연동코드 :</label>
                        <input type="text" class="form-control" maxlength="10" placeholder="마트코드를 입력하세요" id="mart-code" name="mart-code">
                    </div>
                </div>        
                <div class="row mb-3">
                    <div class="col-lg-4">
                        <label for="store-login-id" class="form-label">로그인 아이디 (*) :</label>
                        <input type="text" class="form-control" maxlength="45" placeholder="로그인 아이디를 입력하세요" id="store-login-id" name="store-login-id">
                    </div>
                    <div class="col-lg-4">
                        <label for="store-login-pwd" class="form-label">로그인 암호 (*) :</label>
                        <input type="password" class="form-control" maxlength="20" placeholder="로그인 암호를 입력하세요" id="store-login-pwd" name="store-login-pwd">
                    </div>
                    <div class="col-lg-4">
                        <label for="store-login-pwd-confirm" class="form-label">로그인 암호 확인 (*) :</label>
                        <input type="password" class="form-control" maxlength="20" placeholder="정확한 입력을 위해 암호를 한 번 더 입력하세요" id="store-login-pwd-confirm" name="store-login-pwd-confirm">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-lg-6">
                        <label for="store-name-reg" class="form-label">사업장 이름(ERP) :</label>
                        <input type="text" class="form-control" maxlength="50" placeholder="ERP 등록을 위한 사업장 이름을 입력하세요" id="store-name-reg" name="store-name-reg">
                    </div>
                    <div class="col-lg-6">
                        <label for="store-regno" class="form-label">사업자번호(ERP) :</label>
                        <input type="text" class="form-control" maxlength="20" placeholder="사업자등록번호를 입력하세요" id="store-regno" name="store-regno">
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-lg-6">
                        <label for="shuket-manager" class="form-label">슈켓 담당자 :</label>
                        <input type="text" class="form-control" maxlength="45" placeholder="담당자 이름을 입력하세요." id="shuket-manager" name="shuket-manager">
                    </div>
                    <div class="col-lg-6">
                        <label class="form-label">대행 :</label>
                        <select class="form-select" id="store-manager-id">
                        </select>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-lg-6">
                        <label class="form-label">상태 :</label>
                        <select class="form-select" id="store-active">
                            <option value="A">정상</option>
                            <option value="W">대기</option>
                            <option value="D">이용중지</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary waves-effect waves-light" onclick="updateStore()">저장하기</button>
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->


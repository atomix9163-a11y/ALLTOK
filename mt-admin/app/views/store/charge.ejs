<%- contentFor('style') %>

<%- contentFor('content') %>
<div class="row">
    <div class="col-md-4 col-sm-12 col-xs-12 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="font-size-16 me-3 mb-0">가맹점 목록</h5>
                <hr class="mt-2">
                <div class="row">
                    <div class="col-lg-10">
                        <div class="search-box mb-2 me-2">
                            <div class="position-relative d-inline">
                                <input type="text" id="search-key" class="form-control form-control-sm border-light rounded" placeholder="Search..." value="">
                                <i class="search-icon" data-eva="search-outline" data-eva-height="26" data-eva-width="26"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-2">
                        <button id="search" class=" d-inline fc-today-button btn btn-sm btn-primary" type="button" onclick="searchStore()">검색</button>
                    </div>
                </div>
                <div class="table-responsive mb-3">
                    <table class="table">
                        <thead class="">
                            <tr>
                                <th scope="col">가맹점명</th>
                                <th scope="col">가맹점코드</th>
                                <th scope="col">잔액</th>
                                </tr>
                            </thead>
                        <tbody id="store-list">
                        </tbody>
                    </table>
                </div>
                
                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center" id="store-pager"></ul>
                </nav>
            </div>
        </div>
    </div>
    <div class="col-md-8 col-sm-12 col-xs-12">
        <div class="user-sidebar">
            
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title mb-0" id="charge-history">충전 목록</h5>
                    <hr class="mt-2">
                    <div class="row mb-4 d-none" id="charge-view">
                        <div class="col-sm-3">
                            <input type="date" class="form-control form-control-sm" id="start-date" name="start-date" value="2018-07-22" min="2022-01-01" max="2050-12-31" />
                        </div>
                        <div class="col-sm-3">
                            <input type="date" class="form-control form-control-sm" id="end-date" name="end-date" value="2018-07-22" min="2022-01-01" max="2050-12-31" />
                        </div>
                        <div class="col-sm-2">
                            <select class="form-select form-select-sm" id="cash-type" aria-label="">
                                <option selected value="">전체</option>
                                <option value="A">적립</option>
                                <option value="R">차감</option>
                                <option value="C">정정</option>
                            </select>
                        </div>
                        <div class="col-sm">
                            <button id="search" class="fc-today-button btn btn-primary btn-sm" type="button" onclick="searchChargeHistory()">검색</button>
                        </div>
                        <div class="col-sm-2">
                            <a href="#" onclick="addChargeHistory()" id="btn_addCharge" class="btn btn-primary waves-effect waves-light btn-sm"><i class="bx bx-send me-1 align-middle"></i> 충전하기</a>
                        </div>
                    </div>                    

                    <div class="table-responsive mb-3">
                        <table class="table">
                            <thead class="">
                                <tr>
                                    <th scope="col"></th>
                                    <th scope="col">날짜</th>
                                    <th scope="col">종류</th>
                                    <th scope="col" class="text-end">금액</th>
                                    <th scope="col" class="text-end">충전 전 잔액</th>
                                    <th scope="col" class="text-end">충전 후 잔액</th>
                                    <th scope="col" class="text-end">누적 충전액</th>
                                </tr>
                            </thead>
                            <tbody id="cashHistory-list">
                            </tbody>
                        </table>
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center" id="cashHistory-pager"></ul>
                    </nav>
    
                </div>
                <!-- end card body -->
            </div>
            <!-- end card -->

        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modal-cashHistoryAdd" tabindex="-1" aria-labelledby="modal_groupView_Label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_userView_Label"> 충전하기</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="cashHistory-storeCode">
                <div class="text-center mb-4">                    
                    <p class="card-title-desc">등록된 정보는 삭제/변경이 안됩니다. 잘못입력했다면 적립 또는 차감으로 정정하세요.</p>
                </div>
                <div>
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label class="form-label">충전 종류 :</label>
                                <select class="form-select" id="cashHistory-cashType" aria-label="">
                                    <option selected value="A">적립</option>
                                    <option value="R">차감</option>
                                    <option value="C">정정</option>
                                </select>
                            </div>                                   
                        </div>
                        <div class="col-lg-6">
                            <div class="mb-3">
                                <label for="user_loginId" class="form-label">충전(정정) 금액 :</label>
                                <input type="number" class="form-control" placeholder="금액을 입력하세요" id="cashHistory-amount" name="group_name">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
                <button type="button" class="btn btn-primary waves-effect waves-light" onclick="addCharge()">저장하기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<%- contentFor('script') %>
<script src="/assets/js/numeral.js"></script>

<script>
    const apiServer = '<%=apiServer %>';
    let currentPage = 1;    
    const rowCount = 20;
    let selectedStoreCode = '';
    let selectedStoreName = '';

    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        let d = new Date();
        let lastMonthDate = new Date(moment().add(-6, 'month').format("YYYY-MM-DD"));
        document.getElementById("start-date").value = [lastMonthDate.getFullYear(), (lastMonthDate.getMonth() + 1).AddZero(), lastMonthDate.getDate().AddZero()].join('-');
        document.getElementById("end-date").value = [d.getFullYear(), (d.getMonth() + 1).AddZero(), d.getDate().AddZero()].join('-');

        document.getElementById("search-key").value = "";
        document.getElementById("search-key").addEventListener("keypress", async (e) => {
            if (e.keyCode == 13) {
                await searchStore();
            }
        })

        await showStoreList();
    })

    const showStoreList = async () => {
        const searchKey = document.getElementById("search-key").value;
        const callAPI = `/api/store/list`;
        await axios.post(callAPI, {
            searchKey: searchKey,
            page: currentPage,
            rowCount: rowCount
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {
            let html = "";
            if (response.data.result && response.data.data.rows) {
                for (let item of response.data.data.rows) {
                    html += `<tr>
                                <td><a href="javascript:void(0);" onclick="showChargeHistory('${item.store_code}', '${item.name}', 1)">${item.name}</a></td>
                                <td>${item.store_code}</td>
                                <td class="text-end">${numeral(item.balance).format("0,0.00")}</td>
                            </tr>`
                }
                let pagerHTML = createPagerHTML(response.data.data.count, rowCount, currentPage, 5, "changePage");
                document.getElementById("store-pager").innerHTML = pagerHTML;
            } else {
                document.getElementById("store-pager").innerHTML = "";
            }
            document.getElementById("store-list").innerHTML = html;

        }).catch(error => {
            console.log(error);
            alert("가맹점 목록을 가져오지 못했습니다. 잠시 후 다시 시도해 주십시오.");
        })

    }

    const changePage = async (page, rowPerPage) => {
        currentPage = page;
        await showStoreList();        
    }

    const searchStore = async () => {
        currentPage = 1;
        showStoreList();
    }

    async function searchChargeHistory() {
        showChargeHistory(selectedStoreCode, selectedStoreName, 1);
    }

    async function showChargeHistory(storeCode, storeName, page) {
        selectedStoreCode = storeCode;
        selectedStoreName = storeName;
        let startDate = document.getElementById("start-date").value;
        let endDate = document.getElementById("end-date").value;
        let cashType = document.getElementById("cash-type").value;

        document.getElementById("charge-history").innerHTML = `충전 목록 (${storeCode}/${storeName})`;

        const callAPI = `/api/store/cash/history`;
        let returnData = await axios.post(callAPI, {
            storeCode: storeCode,
            startDate: startDate,
            endDate: endDate,
            page: page,
            rowCount : rowCount,
            cashType: cashType
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {            
            if (response.data.result) {
                document.getElementById("charge-view").classList.remove("d-none");
                let html = "";
                for (let cashHistory of response.data.data.rows) {
                    html += `<tr>
                        <td></td>
                        <td>${(cashHistory.c_time) ? moment(cashHistory.c_time).format('YYYY-MM-DD HH:mm:ss') : ""}</td>
                        <td class='${cashHistory.cash_type == "R" ? "text-danger" : ""}'>${(cashHistory.cash_type == 'A') ? "적립" : (cashHistory.cash_type == "R") ? "차감" : "정정"}</td>
                        <td class='text-end ${cashHistory.cash_type == "R" ? "text-danger" : ""}'>${numeral(cashHistory.amount).format("0,0.00")}</td>
                        <td class='text-end'>${numeral(cashHistory.old_balance).format("0,0.00")}</td>
                        <td class='text-end ${cashHistory.balance <= 0 ? "text-danger" : ""}'>${numeral(cashHistory.balance).format("0,0.00")}</td>
                        <td class='text-end'>${numeral(cashHistory.total_charge).format("0,0.00")}</td>
                    </tr>`
                }
                document.getElementById("cashHistory-list").innerHTML = html;

                let pagerHTML = createPagerHTML(response.data.data.count, rowCount, page, 5, "changePageHistory");
                document.getElementById("cashHistory-pager").innerHTML = pagerHTML;

            }

        }).catch(error => {
            console.log(error);
            return null;
        })
       
        return returnData;        
    }

    function changePageHistory(page, rowPerPage) {
        showChargeHistory(selectedStoreCode, selectedStoreName, page)
    }

    function addChargeHistory() {
        if (selectedStoreCode == "") {
            alert("선택된 가맹점이 없습니다.");
            return;
        } 
        document.getElementById("cashHistory-storeCode").value = selectedStoreCode;        
        document.getElementById("cashHistory-amount").value = "";
        document.getElementById("cashHistory-cashType").value = "A";

        const modal_cashHistoryAdd = new bootstrap.Modal(document.getElementById('modal-cashHistoryAdd'));
        modal_cashHistoryAdd.show();
    }

    function validation(amount) {
        if (amount.length == 0) {
            alert("금액을 입력해야만 합니다.");
            return false;
        }
        return true;
    }

    async function addCharge() {
        let storeCode = document.getElementById("cashHistory-storeCode").value;
        let amount = document.getElementById("cashHistory-amount").value;
        let cashType = document.getElementById("cashHistory-cashType").value;

        if (!validation(amount)) return;

        let callApi = "/api/store/cash/add";
        // 정보를 업데이트        
        await axios.post(callApi, {
            storeCode: storeCode,
            amount: amount, 
            cashType: cashType
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {
            if (response.data.data) {
                let modal = bootstrap.Modal.getInstance(document.getElementById('modal-cashHistoryAdd'));
                modal.hide();

                showChargeHistory(storeCode, selectedStoreName, 1)
            } else {
                alert(`충전 정보를 저장하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`충전 정보를 저장하지 못했습니다.`);});
    }
    
</script>

<%- contentFor('style') %>

<%- contentFor('content') %>
<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-lg-3 col-sm-6">
                        <div class="search-box mb-2 me-2">
                            <div class="position-relative">
                                <input type="text" id="search-key" class="form-control form-control-sm border-light rounded" placeholder="Search...">                                
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-1">
                        <button id="search" class="fc-today-button btn btn-sm btn-primary" type="button" onclick="listAccount(1)">검색</button>
                    </div>
                    <div class="col-lg-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="" id="notAssigned">
                            <label class="form-check-label" for="notAssigned">
                                미연결 계좌만 보기
                            </label>
                          </div>
                    </div>
                    <div class="col-lg-2 d-none">
                        <div class="form-check">
                            <select class="form-select" id="account-type">
                                <option value="29">애드큐</option>
                                <option value="62">애즈위메이크</option>
                            </select>
                        </div>
                    </div>
                </div>

                <h5 class="font-size-16 me-3 mb-0">가상계좌 목록</h5>
                    <hr class="mt-2">
                    <div class="table-responsive mb-5">
                        <table class="table table-striped table-hover">
                            <thead class="">
                                <tr>
                                    <th scope="col">순번</th>
                                    <th scope="col">은행명</th>
                                    <th scope="col">계좌번호</th>
                                    <th scope="col">가맹점 코드</th>
                                    <th scope="col">가맹점 이름</th>
                                    <th scope="col" class="text-center">작업</th>
                                </tr>
                            </thead>
                            <tbody id="account-main">                            
                            </tbody>
                        </table>
                    </div>
                    
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center" id="account-pager"></ul>
                    </nav>
            </div>
        </div>

    </div>
</div>

<!-- 거래처 연결 Modal -->
<div class="modal fade" id="modal-store" tabindex="-1" aria-labelledby="modal_store" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> 가맹점 연결</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-6">
                                        <div class="search-box mb-2 me-2">
                                            <div class="position-relative">
                                                <input type="text" id="search-key-store" class="form-control form-control-sm border-light rounded" placeholder="Search...">                                                
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <button id="btn-search-store" class="fc-today-button btn btn-sm btn-primary" type="button" onclick="listStore(1)">검색</button>
                                    </div>
                                </div>               
                                <div class="table-responsive mb-5">
                                    <table class="table table-striped table-hover">
                                        <thead class="">
                                            <tr>
                                                <th scope="col">가맹점코드</th>
                                                <th scope="col">가맹점명</th>
                                                <th scope="col">앱코드</th>
                                                <th scope="col">마트코드</th>
                                                <th scope="col">담당자</th>
                                                <th scope="col" class="text-center">작업</th>
                                            </tr>
                                        </thead>
                                        <tbody id="store-main">                            
                                        </tbody>
                                    </table>
                                </div>
                                
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center" id="store-pager"></ul>
                                </nav>
                            </div>
                        </div>                
                    </div>
                </div>
            </div>
            <div class="modal-footer">                
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<!-- 신청기록 Modal -->
<div class="modal fade" id="modal-history" tabindex="-1" aria-labelledby="modal_history" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> 입금신청기록</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="card">
                            <div class="card-body">
                                <div class="table-responsive mb-5">
                                    <table class="table table-striped table-hover">
                                        <thead class="">
                                            <tr>
                                                <th scope="col">신청일</th>
                                                <th scope="col">금액</th>
                                                <th scope="col">과오납신청결과</th>
                                                <th scope="col">입금일</th>
                                                <th scope="col">입금결과</th>
                                                <th scope="col">충전일</th>
                                                <th scope="col">충전결과</th>
                                                <th scope="col">진행단계</th>
                                                <th scope="col" class="d-none">TID</th>
                                            </tr>
                                        </thead>
                                        <tbody id="history-main">                            
                                        </tbody>
                                    </table>
                                </div>
                                
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center" id="history-pager"></ul>
                                </nav>
                            </div>
                        </div>                
                    </div>
                </div>

            </div>
            <div class="modal-footer">                
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->


<%- contentFor('script') %>
<script>
    const apiServer = '<%=apiServer %>';
    let page = 1;    
    const rowCount = 100;

    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        document.getElementById("search-key").addEventListener("keypress", async (e) => {
            if (e.keyCode == 13) {
                await listAccount(1);
            }
        })
        await listAccount(1);

        document.getElementById("search-key-store").addEventListener("keypress", async (e) => {
            if (e.keyCode == 13) {
                await listStore(1);
            }
        })

        document.getElementById("account-type").addEventListener("change", async (e) => {
            await listAccount(1);
        })
    })

    const listAccount = async (page) => {
        let searchKey = document.getElementById("search-key").value;
        let notAssigned = document.getElementById("notAssigned").checked;
        // let accountType = document.getElementById("account-type").value;
        let accountType = "62";
        
        let callApi = `/api/account/list`;
        await axios.post(callApi, {            
            searchKey: searchKey,            
            notAssigned: notAssigned ? 'Y' : 'N',
            accountType: accountType ? accountType : '29',
            page: page,
            rowCount : rowCount
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {                        
            if (response.data.result) {
                let HTML = "";
                if (response.data.data.rows) {
                    let num = ((page - 1) * rowCount) + 1;
                    for (let item of response.data.data.rows) {
                        // console.log(item)
                        HTML += `                    
                        <tr>
                            <td>${num++}</td>
                            <td>${item.bank_name}</td>
                            <td>${item.bank_account}</td>
                            <td>${item.store_code ? item.store_code : ''}</td>
                            <td>${item.name ? item.name : ''}</td>
                            <td class='text-center'>
                                ${!item.store_code ? `<button class="btn btn-sm btn-primary me-1" onclick="linkAccount('${item.seq }')"><i class="fas fa-edit"></i> 계좌연결</a>` : ''} 
                                ${item.store_code ? `<button class="btn btn-sm btn-secondary me-1" onclick="showHistory('${item.store_code }')"><i class="fas fa-cogs"></i> 입금신청기록</a> <button class="btn btn-sm btn-danger me-1" onclick="unlinkAccountStore('${item.seq}', '${item.store_code}')"><i class="fas fa-edit"></i> 연결해제</a>` : ''}
                            </td>
                        </tr>`;
                    }
                }
                document.getElementById("account-main").innerHTML = HTML;

                let pagerHTML = createPagerHTML(response.data.data.count, rowCount, page, 5, "changePage");
                document.getElementById("account-pager").innerHTML = pagerHTML;

            }
        })
        .catch(error => { console.log(error); alert(`가상계좌 목록을 가져오지 못했습니다.`);});
    }

    function changePage(page, rowPerPage) {
        console.log(page, rowPerPage)
        listAccount(page);
    }

    let accountSeq = 0;
    const linkAccount = async (accountCode) => {
        accountSeq = accountCode;
        document.getElementById("search-key-store").value = "";
        listStore(1);
        
        const modal = new bootstrap.Modal(document.getElementById('modal-store'))
        modal.show();
    }

    const listStore = async (page) => {
        let searchKey = document.getElementById("search-key-store").value;
        
        let callApi = `/api/store/list`;
        await axios.post(callApi, {            
            searchKey: searchKey,            
            page: page,
            rowCount : 8
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {                        
            if (response.data.result) {
                let HTML = "";
                if (response.data.data.rows) {
                    for (let item of response.data.data.rows) {
                        // console.log(item)
                        HTML += `                    
                        <tr>
                            <td>${item.store_code}</td>
                            <td><a href='#' onclick="linkAccountStore('${accountSeq}', '${item.store_code }')">${item.name}</a></td>
                            <td>${item.M_MOA_CODE ? item.M_MOA_CODE : ""}</td>
                            <td>${item.app_mart_code ? item.app_mart_code : ""}</td>
                            <td>${item.shuket_manager && item.shuket_manager != "" ? item.shuket_manager : "(미지정)" }</td>
                            <td class='text-center'>
                                <button class="btn btn-sm btn-primary" onclick="linkAccountStore('${accountSeq}', '${item.store_code }')"><i class="fas fa-hammer"></i> 연결</a>
                            </td>
                        </tr>`;
                    }
                }
                document.getElementById("store-main").innerHTML = HTML;

                let pagerHTML = createPagerHTML(response.data.data.count, 8, page, 5, "changePageStore");
                document.getElementById("store-pager").innerHTML = pagerHTML;

            }
        })
        .catch(error => { console.log(error); alert(`가맹점 내역을 가져오지 못했습니다.`);});
    }

    const changePageStore = (page, rowPerPage) => {
        listStore(page);
    }

    const linkAccountStore = async (accountCode, storeCode) => {
        // 가상계좌 마트 연결
        let callApi = `/api/account/link`;
        await axios.post(callApi, {            
            accountCode: accountCode,            
            storeCode: storeCode
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {            
            const result = response.data;
            console.log(result)
            if (result.data > 0) {
                let modal = bootstrap.Modal.getInstance(document.getElementById('modal-store'));
                modal.hide();

                listAccount(page);
            } else {
                switch (result.data) {
                    case -3 :
                    case -1 : alert("정보를 검증할 때 오류가 발생했습니다. 잠시 후 다시 시도해 주십시오."); break;
                    case -2 : alert("이미 사용 중인 가상계좌입니다."); break;
                    case -4 : alert("이 가맹점은 다른 가상계좌에 연결되어 있습니다."); break;
                }
            }
        }).catch(error => {
            alert("가상계좌를 가맹점에 연결할 때 오류가 발생했습니다. 잠시 후 다시 시도해 주십시오.");
        })
    }

    const unlinkAccountStore = async (accountCode, storeCode) => {
        if (!confirm("연결을 해제하시겠습니까?")) return;
        // 가상계좌 마트 연결
        let callApi = `${apiServer}/nicepay/apiAccountUnlink`;
        await axios.post(callApi, {            
            accountCode: accountCode,            
            storeCode: storeCode
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {            
            const result = response.data;
            console.log(result)
            if (result.data > 0) {
                listAccount(page);
            } else {
                alert("가상계좌를 해제할 때 오류가 발생했습니다. 잠시 후 다시 시도해 주십시오.");
            }
        }).catch(error => {
            alert("가상계좌를 해제할 때 오류가 발생했습니다. 잠시 후 다시 시도해 주십시오.");
        })
    }

    let historyStoreCode = "";
    const showHistory = async (storeCode) => {
        historyStoreCode = storeCode;

        await listHistory(1);
        const modal = new bootstrap.Modal(document.getElementById('modal-history'))
        modal.show();
    }

    const getProcessType = (processType) => {
        switch (processType) {
            case 0 :
                return "신청";
            case 1 :
                return "입금대기";
            case 2 :
                return "입금완료";
            case 3 :
                return "충전완료";
        }
    }

    const listHistory = async (page) => {
        let callApi = `/api/account/historyList`;
        await axios.post(callApi, {           
            storeCode: historyStoreCode,
            page: page,
            rowCount : 8
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {                        
            if (response.data.result) {
                let HTML = "";
                if (response.data.data.rows) {
                    for (let item of response.data.data.rows) {

                        const callData = JSON.parse(item.verify_call_data);
                        const accountInfo = JSON.parse(item.verify_result_data);
                        const callbackInfo = item.callback_data ? JSON.parse(item.callback_data) : {};

                        console.log(callData)
                        HTML += `
                        <tr>
                            <td>${moment(item.verify_call_time).format("YYYY-MM-DD HH:mm:ss")}</td>
                            <td>${numeral(callData.Amt).format("0,0")}원</td>
                            <td>${item.verify_result_msg}</td>
                            <td>${item.callback_time ? moment(item.callback_time).format("YYYY-MM-DD HH:mm:ss") : ''}</td>
                            <td>${item.callback_result_msg ? item.callback_result_msg : ''}</td>
                            <td>${item.cash_time ? moment(item.cash_time).format("YYYY-MM-DD HH:mm:ss") : ''}</td>
                            <td>${item.cash_amount ? `${numeral(callData.Amt).format("0,0")}원 충전` : ''}</td>
                            <td>${getProcessType(item.procee_step)}</td>
                            <td class="d-none">${item.TID}</td>
                        </tr>`;
                    }
                }
                document.getElementById("history-main").innerHTML = HTML;

                // let pagerHTML = createPagerHTML(response.data.data.count, 8, page, 5, "changePageHistory");
                // document.getElementById("history-pager").innerHTML = pagerHTML;

            }
        })
        .catch(error => { console.log(error); alert(`가맹점 내역을 가져오지 못했습니다.`);});
    }

    const changePageHistory = (page, rowPerPage) => {
        listHistory(page);
    }
</script>

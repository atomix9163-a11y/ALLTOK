<!doctype html>
<html lang="en">
    <head>
        <title>Print</title>
    </head>
    <style type="text/css">
        @media print {
            p.note_content {
                width: auto;
                height: auto;
                border: 1px solid black;
                padding: 15px;
                word-break: break-all;
                line-height: 27px;
            }

            #table_data2 {
                width: 100% !important;
            }
        }

        @media screen {
            p.note_content {
                /* width: 100%; */
                height: auto;
                border: 1px solid black;
                padding: 15px;
                word-break: break-all;
                line-height: 27px;
            }
        }
        /* 27/10/2020 Task 27102020 change font-size 11pt */
        #table_data th,
        #table_data td {
            border: 1px solid #000;
            padding: 5px;
            text-align: center;
            /* font-size:12px; */
            font-size: 11pt;
            /* End Task 27102020 */
        }

        #table_data2 th,
        #table_data2 td {
            border: 1px solid #000;
            padding: 5px;
            text-align: center;
            /* font-size:12px; */
            font-size: 11pt;
            /* End Task 27102020 */
        }

        div {
            /* 27/10/2020 Task 27102020 change font-size 11pt */
            /* font-size: 12px; */
            font-size: 11pt;
            /* End Task 27102020 */
        }

        /* 27/10/2020 Task 27102020 change font-size 11pt */
        #table_info th,
        #table_info td {
            border: none;
            padding: 1px;
            font-weight: bold;
            /* font-size:12px; */
            font-size: 11pt;
        }

        /* End Task 27102020 */
    </style>
    <body>
        <%-content %>

        <%-script %>
    </body>
</html>
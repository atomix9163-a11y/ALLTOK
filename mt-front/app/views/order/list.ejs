<%- contentFor('style') %>

<%- contentFor('content') %>
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">주문 찾기</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-5 ms-lg-auto">
                        <div class="mt-5 mt-lg-4 mt-xl-0">
                            <div class="row mb-4">
                                <label for="horizontal-firstname-input" class="col-sm-3 col-form-label">구분</label>
                                <div class="col-sm-3">
                                    <select class="form-select" id="search-type">
                                        <option value="o_number" selected>주문번호</option>
                                        <option value="o_customer">주문자</option>
                                        <option value="o_phone">휴대폰번호</option>
                                    </select>
                                </div>
                                <div class="col-sm-6">
                                    <input type="text" class="form-control" placeholder="검색어를 입력하세요" id="seach-value">
                                </div>
                            </div>
                        </div>
                        <div class="mt-5 mt-lg-4 mt-xl-0">
                            <div class="row mb-4">
                                <label for="horizontal-firstname-input" class="col-sm-3 col-form-label">주문일</label>
                                <div class="col-sm-4">
                                    <input type="date" class="form-control" id="start-date" name="start-date" value="2018-07-22" min="2025-01-01" max="2050-12-31" />
                                </div>
                                <div class="col-sm-5">
                                    <input type="date" class="form-control" id="end-date" name="end-date" value="2018-07-22" min="2025-01-01" max="2050-12-31" />
                                </div>
                            </div>
                        </div>
                        <div class="mt-5 mt-lg-4 mt-xl-0">
                            <div class="row mb-4">
                                <label for="horizontal-firstname-input" class="col-sm-3 col-form-label">상태</label>
                                <div class="col-sm-9">
                                    <select class="form-select" id="o-status">
                                        <option value="">모두</option>
                                        <option value="60">주문확인중</option>
                                        <option value="61">주문취소</option>
                                        <option value="70">주문완료</option>
                                        <option value="71">결제확인중</option>
                                        <option value="72">주문접수</option>
                                        <option value="80">배송준비중</option>
                                        <option value="81">배송중</option>
                                        <option value="82">배송완료</option>
                                        <option value="83">배송취소</option>
                                        <option value="90">픽업준비중</option>
                                        <option value="91">픽업준비완료</option>
                                        <option value="92">픽업완료</option>
                                        <option value="93">픽업취소</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 ms-lg-auto">
                        <div class="mt-5 mt-lg-4 mt-xl-0">
                            <div class="row mb-4">
                                <label for="horizontal-firstname-input" class="col-sm-3 col-form-label">결제방법</label>
                                <div class="col-sm-9">
                                    <select class="form-select" id="o-payMethod">
                                        <option value="">모두</option>                                        
                                        <option value="CCOD">현장카드결제</option>
                                        <option value="COD">현장현금결제</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-4">
                                <label for="horizontal-firstname-input" class="col-sm-3 col-form-label">주문타입</label>
                                <div class="col-sm-9">
                                    <select class="form-select" id="o-platform">
                                        <option value="">모두</option>
                                        <option value="W">웹주문</option>
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-4">
                                <div class="col-sm-9">
                                    <button type="button" class="btn btn-sm btn-primary btn-lg waves-effect waves-light" onclick="search()">찾기</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">

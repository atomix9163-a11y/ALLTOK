<%- contentFor('style') %>

<%- contentFor('content') %>
<div class="row mb-2 d-none">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">방해금지설정</h4>
            </div>
            <div class="card-body">
                <div class="row mb-2">
                    <div class="col-lg-12 ms-lg-auto">
                        <div class="row">
                            <label for="use-hide-sms" class="col-sm-1 col-form-label">사용 여부</label>
                            <div class="col-sm-3">
                                <div class="form-switch form-switch-md">
                                    <input class="form-check-input" type="checkbox" id="use-hide-sms" onchange="useHideSMS()">
                                </div>   
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mb-4 d-none" id="use-hide-sms-set">
                    <div class="col-lg-12 ms-lg-auto">
                        <div class="row">
                            <label for="horizontal-firstname-input" class="col-sm-1 col-form-label">시간 설정</label>
                            <div class="col-sm-3 d-flex">
                                <input class="form-control form-control-sm" type="time" value="21:00:00" id="use-hide-sms-start">
                                <span class="mt-3 ps-1 pe-1">~</span>
                                <input class="form-control form-control-sm" type="time" value="08:00:00" id="use-hide-sms-end">
                            </div>
                            <div class="col-sm-9 mt-2 "> * 전일 시간부터 다음 날 시간으로 설정</div>
                        </div>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-lg-12 ms-lg-auto">
                        <div class="row">                            
                            <div class="offset-sm-1 col-sm-3 d-flex">
                                <button type="button" class="btn btn-sm btn-success waves-effect waves-light" onclick="saveUseHideSMS()" >
                                    <i class="bx bxs-save font-size-16 align-middle me-2"></i> 저장
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">주문 시 SMS 수신 번호 추가</h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-lg-12 ms-lg-auto">
                        <div class="row">
                            <div class="col-sm-2">
                            <input type="text" class="form-control form-control-sm" id="sa-phone" placeholder="번호만 입력하세요">
                        </div>
                            <div class="col-sm-2">
                                <button type="button" class="btn btn-sm btn-success waves-effect waves-light" onclick="addPhone()" >
                                    새로 등록
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row table-responsive">
                    <table class="table table-striped">
                        <thead class="">
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">휴대폰번호</th>
                                <th scope="col">등록일</th>
                                <th scope="col">작업</th>
                            </tr>
                        </thead>
                        <tbody id="admin-main">
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
    </div>
    <!-- end col -->
</div>
<!-- end row -->

<%- contentFor('script') %>

<script>
    const storeCode = '<%=storeInfo.store_code %>';
    const useHideSMSJSON = JSON.parse(<%-storeInfo.use_hide_sms %>);

    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        setupSMSHide();
        showPhoneList(storeCode);
    })

    const useHideSMS = () => {
        const checkElement = document.getElementById("use-hide-sms");
        if (checkElement.checked) {
            document.getElementById("use-hide-sms-set").classList.remove("d-none");
        } else {
            document.getElementById("use-hide-sms-set").classList.add("d-none")
        }
    }

    const setupSMSHide = () => {
        document.getElementById("use-hide-sms").checked = (useHideSMSJSON.use == 'Y') ? true : false;
        if (useHideSMSJSON.start) document.getElementById("use-hide-sms-start").value = useHideSMSJSON.start;
        if (useHideSMSJSON.end) document.getElementById("use-hide-sms-end").value = useHideSMSJSON.end;
        useHideSMS();
    }

    const saveUseHideSMS = async () => {

        // var timeDiff = (new Date("2023-01-02 " + document.getElementById("use-hide-sms-end").value)).getTime() - (new Date("2023-01-01 " + document.getElementById("use-hide-sms-start").value)).getTime();
        // console.log(timeDiff)

        const temp_useHideSMSJSON = {
            use: (document.getElementById("use-hide-sms").checked) ? "Y" : "N",
            start: document.getElementById("use-hide-sms-start").value,
            end: document.getElementById("use-hide-sms-end").value
        }

        let callApi = `${apiServer}/store/apiUseHideSMSUpdate`;
        await axios.post(callApi, {
            storeCode: store_code,
            useHideSMSJSON: JSON.stringify(temp_useHideSMSJSON)
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(async response => {
            if (response.data.result) {
                alert("저장되었습니다.");
            } else {
                self.location.reload();
            }
        });
    }

    const isNumeric = (str) => {
        return /^\d+$/.test(str);
    }
    
    const addPhone = async () => {
        const phoneElement = document.getElementById("sa-phone");
        let phone = phoneElement.value;
        if (phone.length == 0 || !isNumeric(phone)) {
            alert("전화번호가 입력되지 않았거나, 전화 번호에 숫자 이외의 문자가 포함되어 있습니다.");
            return false;
        }

        let callApi = `${apiServer}/store/apiSMSAdminCreate`;
        await axios.post(callApi, {
            storeCode: storeCode,
            phone: phone
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(async response => {
            await showPhoneList(storeCode);
        });
    }

    const removePhone = async (saCode) => {
        let callApi = `${apiServer}/store/apiSMSAdminDelete`;
        await axios.post(callApi, {
            saCode: saCode
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(async response => {
            await showPhoneList(storeCode);
        });
    }

    async function showPhoneList(storeCode) {               
        let callApi = `${apiServer}/store/apiSMSAdminList`;
        try {
            await axios.post(callApi, {
                storeCode: storeCode
            }, {
                headers: {
                    xtoken: getCookie("xToken")
                }
            }).then(async response => {
                if (response.data.result && response.data.data.length > 0) {
                    let num = 1;
                    let HTML = "";
                    for (let SMSadmin of response.data.data) {      
                        HTML += `
                            <tr>
                                <th scope="row">${num++}</th>
                                <td>${SMSadmin.SA_PHONE}</td>
                                <td>${moment(SMSadmin.C_TIME).format('YYYY-MM-DD HH:mm:ss')}</td>
                                <td>
                                    <button type="button" class="btn btn-xs btn-danger" onclick="removePhone('${SMSadmin.SA_CODE}')">삭제</button>
                                </td>
                            </tr>
                        `
                    }
                    document.getElementById("admin-main").innerHTML = HTML;
                } else {
                    document.getElementById("admin-main").innerHTML = "";
                }
            })
            .catch(error => { 
                console.log(error); 
                throw new Error(`주문 관리자 목록을 가져오지 못했습니다: ${error.message}`);
            });
        
        } catch (e) {
            console.error(e);
            alert(e.message);
        }
    }   
    
</script>
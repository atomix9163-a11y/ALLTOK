                        <%} %>
                        
                        <% if (storeInfo.service.AT == "Y") {%>
                            <li class="py-1"><i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>알림톡 <%=`이용 중 (${storeInfo.service.UP_AT})` %></li>

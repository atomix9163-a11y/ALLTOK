                                    <a href="#" onclick="showAffiliatedStore('<%-storeInfo.store_code %>')" class="btn btn-primary waves-effect waves-light btn-sm"><i class="bx bx bx-edit-alt me-1 align-middle"></i> 정보 수정</a>
                                </div>
                            </div>

                        </div>

                        <%} %>

                        <% if (storeInfo.service.LMS == "Y") {%> 
                            <li class="py-1"><i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>LMS <%=`이용 중 (${storeInfo.service.UP_LMS})` %></li>
                        <%} %>

                        <% if (storeInfo.service.RCSSMS == "Y") {%>
                            <li class="py-1"><i class="mdi mdi-circle-medium me-1 text-success align-middle"></i>RSC SMS <%=`이용 중 (${storeInfo.service.UP_RCSSMS})` %></li>
                        <%} %>


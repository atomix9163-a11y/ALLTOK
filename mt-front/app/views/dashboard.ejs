<%- contentFor('script') %>
<script>
    const apiServer = '<%=apiServer %>';
    const rowCount = 10;
    const store_code = '<%=user.store_code %>';

    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        document.getElementById("modal_affiliatedStoreSave").addEventListener("click", updateAffiliatedStore);

        // 폰 발송 내역 10개
        showPhoneHistoryMainList(1);

        // 표준 발송 내역 10개
        showRCSHistoryMainList(1);

        // 충전 내역 10개
        showCashHistoryMainList(1);
    })

    async function showPhoneHistoryMainList(page) {       
        let callApi = `${apiServer}/history/apiList`;
        await postData(callApi, {
            store_code: store_code,
            start_date: "",
            end_date: "",
            page: page,
            rowCount : rowCount
        })
        .then(returnResult => {
            if (returnResult && returnResult.result) {
                let historyHTML = "";
                let num = returnResult.data.count - (page - 1) * rowCount;
                for (let history of returnResult.data.rows) {
                    let send_time = history.send_time;
                    if (history.send_type == "I") {
                        
                    }
                    historyHTML += `                    
                        <tr>
                            <th scope="row">${num--}</th>
                            <td>${moment(history.C_TIME).format('YYYY-MM-DD')}</td>
                            <td>${(history.send_method == "P") ? "폰문자" : "폰알림톡"}</td>
                            <td>${(history.send_type == "I") ? "즉시" : "예약"}</td>
                            <td>${history.send_no}</td>
                            <td>${(history.reserve_time) ? moment(history.reserve_time).format('YYYY-MM-DD HH:mm:ss') : ""}</td>
                            <td>${(history.send_time) ? moment(history.send_time).format('YYYY-MM-DD HH:mm:ss') : ""}</td>
                            <td>${(history.response == "W") ? "대기" : (history.response == "C") ? "취소" : "완료"}</td>
                            <td>${history.send_count}</td>
                            <td>${history.success_count}</td>
                            <td>${history.fail_count}</td>
                            <td>${numeral(history.success_count / ((history.send_count == 0) ? 1 : history.send_count) * 100).format("0.00")}%</td>
                        </tr>`;
                }
                document.getElementById("phone-main").innerHTML = historyHTML;

            }
        })
        .catch(error => { console.log(error); alert(`발송 내역을 가져오지 못했습니다.`);;});
    }

    async function showRCSHistoryMainList(page) {
        let callApi = `${apiServer}/history/apiListRCS`;
        await postData(callApi, {
            store_code: store_code,
            start_date: "",
            end_date: "",
            page: page,
            rowCount : rowCount
        })
        .then(returnResult => {
            if (returnResult && returnResult.result) {
                let historyHTML = "";
                let num = returnResult.data.count - (page - 1) * rowCount;
                for (let history of returnResult.data.rows) {
                    let send_time = history.send_time;
                    if (history.send_type == "I") {
                        
                    }
                    historyHTML += `                    
                        <tr>
                            <th scope="row">${num--}</th>
                            <td>${history.msg_type}</td>
                            <td>${moment(history.request_time).format('YYYY-MM-DD hh:mm:ss')}</td>
                            <td>${(history.status != "I") ? moment(history.reserve_time).format('YYYY-MM-DD hh:mm:ss') : ""}</td>
                            <td>${history.send_count}</td>
                            <td>${(history.status == "I") ? "즉시" : (history.status == "R") ? "예약" : "발송예약취소"}</td>
                            <td>${(history.status == "R") ? 
                                `<button type="button" class="btn btn-sm btn-danger waves-effect waves-light" onClick="cancelReserve('${history.reserve_code}')">
                                <i class="bx bx-trash font-size-8 align-middle me-2"></i> 취소</button>` : ''}
                            </td>
                        </tr>`;
                }
                document.getElementById("rcs-main").innerHTML = historyHTML;
            }
        })
        .catch(error => { console.log(error); alert(`발송 내역을 가져오지 못했습니다.`);;});
    }

    async function showCashHistoryMainList(page) {       
        let callApi = `${apiServer}/cash/apiCashHistoryList`;
        await postData(callApi, {
            store_code: store_code,
            start_date: "",
            end_date: "",
            page: page,
            rowCount : rowCount
        })
        .then(returnResult => {            
            if (returnResult && returnResult.result) {
                let historyHTML = "";
                let num = returnResult.data.count - (page - 1) * rowCount;
                for (let history of returnResult.data.rows) {
                    historyHTML += `                    
                        <tr>
                            <th scope="row">${num--}</th>
                            <td>${moment(history.c_time).format('YYYY-MM-DD')}</td>
                            <td>${moment(history.c_time).format('HH:mm:ss')}</td>
                            <td>${(history.cash_type == "A") ? "적립" : (history.cash_type == "R") ? "차감" : "정정"}</td>
                            <td>${history.amount.format()} 원</td>
                            <td>${history.balance.format()} 원</td>
                        </tr>
                            `
                }
                document.getElementById("cash-main").innerHTML = historyHTML;

                // let pagerHTML = createPagerHTML(returnResult.data.count, rowCount, page, 5, "changePageMain");
                // document.getElementById("history-main-pager").innerHTML = pagerHTML;

            }
        })
        .catch(error => { console.log(error); alert(`충전 내역을 가져오지 못했습니다.`);;});
    }

    async function showAffiliatedStore(store_code) {
        // 정보를 얻어온다        
        await axios.post(`${apiServer}/affiliatedStore/apiGet`, {
            store_code: store_code
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(returnResult => {
            // console.log(returnResult.data.data)
            if (returnResult && returnResult.data.result) {
                document.getElementById("as_store_code").value = returnResult.data.data.store_code;
                if (returnResult.data.data.logo_image && returnResult.data.data.logo_image != "") document.getElementById("as_logo").src = `${apiServer}/public/uploads/store/${returnResult.data.data.logo_image}`;
                document.getElementById("as_name").value = returnResult.data.data.name;
                document.getElementById("as_owener").value = returnResult.data.data.owener;
                document.getElementById("as_regno").value = returnResult.data.data.regno;
                document.getElementById("as_address").value = returnResult.data.data.address;
                document.getElementById("as_email").value = returnResult.data.data.email;
                document.getElementById("as_contact").value = returnResult.data.data.contact;
                document.getElementById("as_login_id").value = returnResult.data.data.login_id;
                document.getElementById("as_workingTime").value = returnResult.data.data.working_time;
                document.getElementById("as_holidays").value = returnResult.data.data.holidays;
                document.getElementById("as_mapLocation").value = returnResult.data.data.map_location;
                document.getElementById("as_deliveryComment").value = returnResult.data.data.delivery_comment;
                document.getElementById("as_use_mobile_order").value = returnResult.data.data.use_mobile_order;
                document.getElementById("as_mobile_order_limit").value = returnResult.data.data.mobile_order_limit;
                if (returnResult.data.data.mart_image && returnResult.data.data.mart_image != "") document.getElementById("as_mart").src = `${apiServer}/public/uploads/store/${returnResult.data.data.mart_image}`;
                document.getElementById("as_login_pwd").value = "";

                const modal_affiliatedStoreView = new bootstrap.Modal(document.getElementById('modal_affiliatedStoreView'));
                modal_affiliatedStoreView.show();
            } else {
                alert("가맹점 정보를 읽지 못했습니다.");
            }
        })
        .catch(error => { console.log(error); alert("가맹점 정보를 읽지 못했습니다.");});
    }

    function validation(store_code, 
            name, 
            owener, 
            regno, 
            address, 
            email, 
            contact,
            login_pwd,
            login_pwd_confirm) {
        if (login_pwd.length != 0 &&  (login_pwd != login_pwd_confirm)) {
            alert("암호와 확인 암호가 다릅니다.");
            return false;
        }
        return true;
    }

    async function updateAffiliatedStore() {
        let store_code = document.getElementById("as_store_code").value;
        let name = document.getElementById("as_name").value.trim();
        let owener = document.getElementById("as_owener").value;
        let regno = document.getElementById("as_regno").value;
        let address = document.getElementById("as_address").value;
        let email = document.getElementById("as_email").value;
        let contact = document.getElementById("as_contact").value;
        let workingTime = document.getElementById("as_workingTime").value;
        let holidays = document.getElementById("as_holidays").value;
        let mapLocation = document.getElementById("as_mapLocation").value;
        let deliveryComment = document.getElementById("as_deliveryComment").value;
        let login_pwd = document.getElementById("as_login_pwd").value;
        let login_pwd_confirm = document.getElementById("as_login_pwd_confirm").value;
        let use_mobile_order = document.getElementById("as_use_mobile_order").value;
        let mobile_order_limit = (document.getElementById("as_mobile_order_limit").value == "") ? 0 : document.getElementById("as_mobile_order_limit").value;

        if (!validation(
            store_code, 
            name, 
            owener, 
            regno, 
            address, 
            email, 
            contact,
            login_pwd,
            login_pwd_confirm)) return;

        // if (!confirm(`사용자 정보가 ${(seq == "") ? "추가" : "변경"}됩니다. 계속하시겠습니까?`)) return;

        let callApi = `${apiServer}/affiliatedStore/apiUpdateStore`;
        // 정보를 업데이트        
        await axios.post(callApi, {
            store_code: store_code, 
            name: name, 
            owener: owener, 
            regno: regno, 
            address: address, 
            email: email,             
            workingTime: workingTime,
            holidays: holidays,
            mapLocation: mapLocation,            
            deliveryComment: deliveryComment,
            contact: contact,
            login_pwd: login_pwd,
            use_mobile_order: use_mobile_order,
            mobile_order_limit: mobile_order_limit
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(returnResult => {
            if (returnResult && returnResult.data.result) {
                self.location.reload();
            } else {
                alert(`가맹점 정보를 변경하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`가맹점 정보를 변경하지 못했습니다.`);});
    }

    async function uploadImage(obj, target){
        let uploadFile = obj;
        const formData = new FormData();
        formData.append("uploadFile", uploadFile.files[0]);
        // formData.append("location", "store");

        await axios.post(`${apiServer}/upload/uploadSingle`, formData, {
            headers: {
                "Content-Type": "multipart/form-data",
                "location": "store"
            },
        })
        .then(async response =>  {
            let photo = response.data.data.filename;
            let path = response.data.data.path;
            if (response.data.result === "success") {
                // 업로드한 파일로 업데이트 실시
                await axios.post(`${apiServer}/affiliatedStore/apiUpdateStorePhoto`, {
                    store_code: document.getElementById("as_store_code").value,
                    target: target,
                    photo: photo,
                    path: path
                }, {
                    headers: {
                        xtoken: getCookie("xToken")
                    }
                }).then(async response => {
                    // 로고 업데이트
                    if (target == "logo_image") {
                        document.getElementById("as_logo").src = `${apiServer}/public/uploads/store/${photo}`;
                    } else {
                        document.getElementById("as_mart").src = `${apiServer}/public/uploads/store/${photo}`;
                    }
                })
            } else {
                alert("파일 업로드를 실패했습니다.");
                return null;
            }
        });
    }

    async function resetImage(target) {
        await axios.post(`${apiServer}/affiliatedStore/apiUpdateStorePhoto`, {
            store_code: document.getElementById("as_store_code").value,
            target: target,
            photo: "",
            path: ""
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(async response => {
            // 로고 업데이트
            if (target == "logo_image") {
                document.getElementById("as_logo").src = "";
            } else {
                document.getElementById("as_mart").src = "";
            }

        })

    }

</script>
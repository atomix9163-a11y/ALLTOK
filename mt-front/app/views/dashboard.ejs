                            alt="">
                        <div class="overlay-content rounded-top">
                            <div>
                                <div class="user-nav p-3">
                                    <div class="d-flex justify-content-end">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- end user-profile-img -->

                    <div class="position-relative">
                        <div class="text-center">

                            <div class="mt-3">
                                <%-(storeInfo.logo_image) ? `<img src="${apiServer}/public/uploads/store/${storeInfo.logo_image}" style="height: 30px;" alt="">` : `<h5 class="mb-1" style="color: black;">${storeInfo.name}</h5>` %>

<%- contentFor('style') %>

<%- contentFor('content') %>
<div id="root" class="root front-container">

    <!-- CONTENTS -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <section id="content" class="content">
        <div class="content__boxed w-100 min-vh-100 d-flex flex-column align-items-center justify-content-center">
            <div class="content__wrap">

                <!-- Login card -->
                <div class="card shadow-lg">
                    <div class="card-body">

                        <div class="text-center">
                            <img src="/assets/img/alltok-logo-3-dark.png" style="height: 40px; width: auto;" class="mb-3">
                            <h1 class="h3">로그인</h1>
                            <p>가맹점 시스템</p>
                        </div>

                        <div class="mb-3">
                            <input type="text" class="form-control" id="input-username" placeholder="아이디를 입력하세요" autofocus>
                        </div>

                        <div class="mb-3">
                            <input type="password" class="form-control pe-5" id="password-input" placeholder="암호를 입력하세요">
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="remember-check">
                            <label for="_dm-loginCheck" class="form-check-label">
                                기억하기
                            </label>
                        </div>

                        <div class="d-grid mt-5">
                            <button class="btn btn-primary btn-lg" type="submit" id="btn-login">로그인</button>
                        </div>
                        
                    </div>
                </div>
                <!-- END : Login card -->

                <div class="card shadow-lg mt-4 d-none">
                    <div class="card-body">
                        (주)슈켓<br>
                        237-81-01274<br>
                        인천광역시 남동구 성말로 13번길 36-14, 6층
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!-- END - CONTENTS -->
</div>

<%- contentFor('script') %>
<!-- <script src="/assets/js/pages/pass-addon.init.js"></script>
<script src="/assets/js/pages/eva-icon.init.js"></script> -->

<script>
    const apiServer = '<%=apiServer %>';
    let loginResultCode = '<%=resultCode %>';
    let refer = '<%=refer %>';

    document.addEventListener("DOMContentLoaded", async function(){
        loginViewMessage();

        let savedLoginId = getCookie("loginid");
        if (savedLoginId && savedLoginId.length) {
            document.getElementById("input-username").value = savedLoginId;
            document.getElementById("remember-check").checked = true;
        }

        document.getElementById("input-username").addEventListener("keypress", function(e) { 
            if (e.keyCode == 13) { document.getElementById("password-input").focus(); return false;}
        });
        
        document.getElementById("password-input").addEventListener("keypress", function(e) { 
            if (e.keyCode == 13) {  processLogin(); return false;}
        });
        
        document.getElementById("btn-login").addEventListener("click", processLogin);
    })

    function loginViewMessage(){
        switch (loginResultCode) {
            case '1':
                alert("로그인 정보가 올바르지 않습니다.");
                break;
            case '2':
                alert("로그인이 처리되지 않았습니다. 잠시 후에 다시 시도해 주십시오.");
                break;
            case '3':
                alert("이 사용자는 접근 권한이 없습니다.");
                break;
        }
    }

    async function processLogin() {
        const loginId = document.getElementById("input-username").value;
        const password = document.getElementById("password-input").value;

        if (loginId.length == 0 || password.length == 0) {
            alert("아이디와 암호를 입력하세요.");
            return;
        }

        await postData(`${apiServer}/auth/verifyStore`, {
            loginId: loginId,
            password: password
        })
        .then(returnResult => {
            if (returnResult && returnResult.result) {
                if (document.getElementById("remember-check").checked == true) {
                    setCookie("loginid", returnResult.data.login_id, {secure: true, 'max-age': 3600, path: '/'});
                } else {
                    setCookie("loginid", returnResult.data.login_id, {secure: true, 'max-age': 0, path: '/'});
                }
                setCookie("xToken", returnResult.data.token, {secure: true, 'max-age': 3600, path: '/'});
                let saveCookie = `xToken=${returnResult.data.token};path=/;`
                document.cookie = saveCookie;
                self.location.href = "/";
            } else if (returnResult && !returnResult.result) {
                if (returnResult.data.code == 2) {
                    alert("암호가 올바르지 않습니다.");
                } else if (returnResult.data.code == 3) {
                    alert("아이디를 찾을 수 없습니다.");
                } else if (returnResult.data.code == 1) {
                    alert("미승인 아이디입니다. 승인을 기다리거나 관리자에게 문의하십시오.");
                }
            }
        })
        .catch(error => { console.log(error); return false;});
    
    }
</script>
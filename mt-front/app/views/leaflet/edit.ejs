    const getPlainTextForImageSearch = (name) => {
        let splitedName = name.split(" ");
        let plainName = (splitedName.length > 0) ? splitedName[0] : products.A;
        // 괄호 및 내용 제거
        plainName = plainName.replace(/\([^)]*\)/gi, "");
        plainName = plainName.replace(/\[[^)]*\]/gi, "");
        // 영문제거
        plainName = plainName.replace(/[A-Za-z]/gi, "");
        // 숫자 제거
        plainName = plainName.replace(/[0-9]/gi, "");
        // 구분자인 |를 제외한 모든 특수문자 제거
        plainName = plainName.replace(/[\{\}\[\]\/?.,;:\)*~`!^\-_+<>@\#$%&\\\=\(\'\" ]/gi, "");

        return plainName;
    }


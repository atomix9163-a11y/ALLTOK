                        </div>
                    </div>
                    <!-- end card body -->
                </div>
            </div>
            <div class="p-4 text-center">
                <button type="button" class="btn btn-primary" onclick="changeTemplate()">템플릿 변경하기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<div id="loading" class="d-none">
    <div class="dialog">
        <p class="mt-3"><h4 id="loading-message">이미지를 찾아서 적용 중입니다.</h4></p>
        <p>
            <img src="/assets/img/alltok/processing.gif">
        </p>
        <p class="mb-3">잠시 기다려 주십시오.</p>
    </div>
</div>

<%- contentFor('script') %>
<script src="/assets/js/tagin.js"></script>
<script lang="javascript" src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
<script lang="javascript" src="/assets/js/fileSaver/fileSaver.min.js"></script>
<script src="/assets/vendors/@ckeditor5-41.2.1/build/ckeditor.js"></script>
<script src="https://cdn.jsdelivr.net/npm/litepicker/dist/litepicker.js"></script>
<script src="/assets/js/product-helper.js"></script>
<script src="/assets/js/leaflet.js"></script>

<script>
    const qmSyncServer = `<%=qmSyncServer.replace('{martId}', storeInfo.app_mart_code) %>`;
    const shopType = '<%=storeInfo.shop_type %>';
    const storeCode = '<%=storeInfo.store_code %>';
    const leafletCode = "<%=leafletInfo.LEAFLET_CODE %>";
    const useShop = '<%=storeInfo.use_mobile_order %>';
    let litepickerStartDate;
    let litepickerEndDate;
    let searchTagin;
    let dataJSON = null;
    const maxNoticeCount = 60000;
    const maxInfoCount = 30000;
    let isInit = true;
    const rowCount = 12;

    let sectionInitData = [
                {
                    section: 0,
                    title: "야채",
                    img: "",
                    color: "#000000",
                    bgcolor: "#ffffff",
                    useTable: false,
                    order: 0,
                    hide: false,
                    status: 'A',
                    product: []
                },
                {
                    section: 1,
                    title: "청과",
                    img: "",
                    color: "#000000",
                    bgcolor: "#ffffff",
                    useTable: false,
                    order: 1,
                    hide: false,
                    status: 'A',
                    product: []
                },
                {
                    section: 2,
                    title: "정육",
                    img: "",
                    color: "#000000",
                    bgcolor: "#ffffff",
                    useTable: false,
                    order: 2,
                    hide: false,
                    status: 'A',
                    product: []
                },
                {
                    section: 3,
                    title: "수산",
                    img: "",
                    color: "#000000",
                    bgcolor: "#ffffff",
                    useTable: false,
                    order: 3,
                    hide: false,
                    status: 'A',
                    product: []
                },
                {
                    section: 4,
                    title: "공산품",
                    img: "",
                    color: "#000000",
                    bgcolor: "#ffffff",
                    useTable: false,
                    order: 4,
                    hide: false,
                    status: 'A',
                    product: []
                },
            ]

    window.onbeforeunload = function () {
        // event.returnValue = "페이지를 벗어 나시겠습니까?";
        // 변경이 일어나서 저장 버튼이 활성화되었는지 확인
        let leafetActionElement = document.querySelector('.leaflet-action');
        if (!leafetActionElement.classList.contains("d-none")) {            
            return false;
        }    
    }
    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        await init();
        
        dataJSON = await getLeaftlet(leafletCode);
        if (dataJSON) {
            showLeaflet();
        }
        isInit = false;

        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))

    })

    const init = async () => {
        // 날짜 선택자 기본 값 및 이벤트 설정
        litepickerStartDate = new Litepicker({ 
            element: document.getElementById('dt-leaflet-start-date'),
            format: 'YYYY-MM-DD',
        });
        litepickerStartDate.on("selected", (date) => {
            document.getElementById("swc-leaflet-range-use").checked = true;
            showLeafletAction(true, false);
        })
        litepickerEndDate = new Litepicker({ 
            element: document.getElementById('dt-leaflet-end-date'),
            format: 'YYYY-MM-DD'
        });
        litepickerEndDate.on("selected", (date) => {
            document.getElementById("swc-leaflet-range-use").checked = true;
            showLeafletAction(true, false);
        })
        let html = "";
        for (let hour = 0; hour <= 24; hour++) {
            html += `<option valaue="${numeral(hour).format("00")}">${numeral(hour).format("00")}</option>`
        }
        document.getElementById("dt-leaflet-start-hour").innerHTML = html;
        document.getElementById("dt-leaflet-start-hour").addEventListener("change", () => { showLeafletAction(true, false); })
        document.getElementById("dt-leaflet-end-hour").innerHTML = html;
        document.getElementById("dt-leaflet-end-hour").addEventListener("change", () => { showLeafletAction(true, false); })
        // 에디터 설정
        ClassicEditor.create(document.querySelector("#push-content"), {   
            toolbar: {
                items : ['bold', 'italic', 'fontSize', 'highlight', 'alignment', 'fontColor', 'fontBackgroundColor' ], 
                shouldNotGroupWhenFull: true
            },
            language: 'ko'         
        }).then(ckeditor => {
                editor = ckeditor;
                ckeditor.model.document.on('change:data', ( evt, data ) => {
                    updatePushCount(maxNoticeCount, "push-content-area", "push-notice-count");
                })

            }).catch(function(e){console.error(e)}
        );
        document.getElementById("show-order-notice").value = "1";
        document.getElementById("show-order-leaflet").value = "2";
        document.getElementById("show-order-product").value = "3";
        document.getElementById("show-order-info").value = "4";
        ClassicEditor.create(document.querySelector("#info-content"), { 
            toolbar: {
                items : ['bold', 'italic', ,'fontSize', 'highlight', 'alignment', 'fontColor', 'fontBackgroundColor'], 
                shouldNotGroupWhenFull: true
            },
            language: 'ko'
        }).then(ckeditor => {
                editor = ckeditor;
                ckeditor.model.document.on('change:data', ( evt, data ) => {
                    updatePushCount(maxNoticeCount, "info-content-area", "push-info-count");
                })

            }).catch(function(e){console.error(e)}
        );

        // 이미지 검색에서 사용할 엘리먼트
        searchTagin = new Tagin(document.getElementById("photo-tags"), { enter: false, placeholder: "검색 내용을 스페이스 또는 엔터로 구분하여 입력", enterFunc: seachPhotoKeyPress});

        // shopType == QU, 큐마켓 단독일 경우만 큐마켓 상품 연동을 활성화한다
        if (shopType == "QU") document.getElementById("leaflet-qmsync-action").classList.remove("d-none");
    }

    // 데이터 기초 생성
    const initDataJSON = () => {
        let tempJSON = {
            topNotice: "",
            bottomInfo: "",
            leaflet: {
                leaflet1: "",
                leaflet2: "",
                leaflet3: "",
                leaflet4: "",
                leaflet5: "",
                leaflet6: "",
                leaflet7: "",
                leaflet8: "",
                leaflet9: "",
            },
            section: [],
            showOrder: [
                {
                    index: 1,
                    target: "notice"
                },
                {
                    index: 2,
                    target: "leaflet"
                },
                {
                    index: 3,
                    target: "product"
                },
                {
                    index: 4,
                    target: "info"
                },
            ]
        }
        tempJSON.section = sectionInitData;
        return tempJSON;
    }

    // 상품 데이터를 초기화
    const initialiszeData = () => {        
        dataJSON.data.section = sectionInitData;
        updateSectionList();
        showLeafletAction(true, true);
    }


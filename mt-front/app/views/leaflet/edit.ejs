<%- contentFor('style') %>
<link rel="stylesheet" href="/assets/vendors/flatpickr/flatpickr.min.css">
<link rel="stylesheet" href="https://unpkg.com/tagin@2.0.2/dist/tagin.min.css">
<link rel="stylesheet" href="/assets/css/leaflet.css">

<%- contentFor('content') %>

<div class="row leaflet mb-3">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-9">
                        <div class="d-flex">
                            <div class="col-auto me-2 pt-1">
                                사용 기간 설정
                            </div>
                            <div class="col-auto me-1">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="swc-leaflet-range-use" onclick="toggleUseTimeSetting(this)">                                    
                                </div>
                            </div>
                            <div class="col-6 me-1 d-flex">
                                <input type="text" class="form-control form-control-sm dt-leaflet-date me-1" id="dt-leaflet-start-date" style="width: 100px;">
                                <select class="form-select form-select-sm me-1" id="dt-leaflet-start-hour" style="width: 80px;"></select>
                                <input type="text" class="form-control form-control-sm dt-leaflet-date me-1" id="dt-leaflet-end-date" style="width: 100px;">
                                <select class="form-select form-select-sm" id="dt-leaflet-end-hour" style="width: 80px;"></select>
                            </div>                            
                            <div class="col-auto me-1">
                                <button type="button" class="btn btn-sm btn-primary waves-effect waves-light" onclick="changeTemplateModal()">
                                    <i class="far fa-eye font-size-16 align-middle me-2"></i> 템플릿 변경
                                </button>
                            </div>                
                            <div class="col-auto me-1">
                                <button type="button" class="btn btn-sm btn-success waves-effect waves-light" onclick="showLeafletReview()">
                                    <i class="far fa-eye font-size-16 align-middle me-2"></i> 미리보기 갱신
                                </button>
                            </div>                
                            <div class="col-auto">
                                <button type="button" class="btn btn-sm btn-dark waves-effect waves-light" onclick="gotoList()">
                                    <i class="far fa-list-alt font-size-16 align-middle me-2"></i> 목록으로 돌아가기
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-3 text-end d-none leaflet-action">
                        <button class="btn btn-sm btn-secondary" onclick="applyChangeCancel('', '')">변경사항 취소</button>
                        <button class="btn btn-sm btn-danger" onclick="applyChange('', '')">변경사항 적용</button>
                    </div>
                    <div class="col-3 text-end d-none" id="leaflet-qmsync-action">
                        <button class="btn btn-sm btn-warning" onclick="syncProducts()">큐마켓 상품 보내기</button>
                    </div>
                </div>
            </div>            
        </div>
    </div>
    <!-- end col -->
</div>

<div class="row leaflet">
    <div class="col-lg-4 col-md-6 col-sm-6">
        <div class="card">
            <div class="card-body">
                <div class="row mb-1">
                    <div class="col-10">
                        행사 안내는 변경 저장 시 미리보기에 적용됩니다.
                    </div>
                    <div class="col-2">
                        <select class="form-select form-select-sm" id="show-order-notice" onchange="changeShowOrder('notice', this)" style="width: 80px;">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-12" id="push-content-area">
                        <textarea id="push-content"></textarea>
                        <div class="badge rounded-pill bg-dark float-end mt-1" role="alert" id="push-notice-count">0/10,000 byte</div>
                    </div>
                </div>
                <div class="row mb-1">
                    <div class="col-10">
                        <h5>전단지</h5>
                    </div>
                    <div class="col-2">
                        <select class="form-select form-select-sm" id="show-order-leaflet" onchange="changeShowOrder('leaflet', this)" style="width: 80px;">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                        </select>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-12">                        
                        <div class="row text-center mb-3">
                            <div class="col-md-4" id="leaflet-1"></div>
                            <div class="col-md-4" id="leaflet-2"></div>
                            <div class="col-md-4" id="leaflet-3"></div>
                        </div>
                        <div class="row text-center mb-3">                            
                            <div class="col-md-4" id="leaflet-4"></div>
                            <div class="col-md-4" id="leaflet-5"></div>
                            <div class="col-md-4" id="leaflet-6"></div>
                        </div>
                        <div class="row text-center">
                            <div class="col-md-4" id="leaflet-7"></div>
                            <div class="col-md-4" id="leaflet-8"></div>
                            <div class="col-md-4" id="leaflet-9"></div>
                        </div>
                    </div>
                </div>
                <div class="row mb-1">
                    <div class="col-10">
                        행사 안내는 변경 저장 시 미리보기에 적용됩니다.
                    </div>
                    <div class="col-2">
                        <select class="form-select form-select-sm" id="show-order-info" onchange="changeShowOrder('info', this)" style="width: 80px;">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <h5>추가 내용</h5>
                    <div class="col-12" id="info-content-area">
                        <textarea id="info-content"></textarea>
                        <div class="badge rounded-pill bg-dark float-end mt-1" role="alert" id="push-info-count">0/5,000 byte</div>
                    </div>
                </div>
            </div>            
        </div>        
    </div>
    <div class="col-lg-5 col-md-6 col-sm-6">
        <div class="toolbar mb-2">
            <div class="toolbar-start">
                <button type="button" class="btn btn-xs btn-primary" onclick="addProductsExcelView()">
                    엑셀 업로드
                </button>
                <button type="button" class="btn btn-xs btn-success" onclick="downloadProductsExcel()">
                    엑셀 다운로드
                </button>
                <button type="button" class="btn btn-xs btn-danger" onclick="initialiszeData()">
                    전체 초기화
                </button>
            </div>
            <div class="toolbar-end">
                <button type="button" class="btn btn-xs btn-danger" onclick="addSection()">
                    섹션 추가
                </button>
                <select class="form-select form-select-sm" id="show-order-product" style="width: 80px;" onchange="changeShowOrder('product', this)">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                </select>
            </div>
        </div>
        <div class='list-hidden'></div>
        <div class="" id="section-list"></div>
        <div class="card leaflet-action d-none">
            <div class="card-body">
                <div class="text-end">
                    <button class="btn btn-secondary btn-sm" onclick="applyChangeCancel('', '')">변경사항 취소</button>
                    <button class="btn btn-danger btn-sm" onclick="applyChange('', '')">변경사항 적용</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-12 col-sm-12">
        <div class="phone-mobile">
            <div id="leaflet-review">
            </div>
        </div>
    </div>
</div>

<div id="syncProcess" class="d-none">
    <div class="dialog">
        <p class="mt-3"><h4 id="loading-message">큐마켓으로 올톡에 등록된 상품들이 연동 중입니다.</h4></p>
        <p><img src="/assets/img/alltok/mail-send.gif"></p>
        <p class="mb-3">연동이 완료되면 자동으로 닫히므로 잠시 기다려 주십시오.</p>        
    </div>
</div>

<!-- 엑셀 업로드 -->
<input type="hidden" id="addProductExcel-division" name="addProductExcel-division">
<input type="hidden" id="addProductExcel-section" name="addProductExcel-section">
<div class="modal fade" id="modal-excelUpload" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> 상품 엑셀 업로드</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <label for="uploadFile" class="form-label">정해진 포맷의 엑셀 파일을 이용하세요. <a href="/assets/files/sample.xlsx" target="_blank">sample.xlsx</a></label>
                    <p>내용을 지우고 등록하실 내용으로 변경하세요</p>
                    <p>카테고리는 A열만 입력하세요.</p>
                    <p>상품명, 단위, 판매가격, 바코드(옵션), 사진경로(옵션) 순서입니다.</p>
                    <p>사진경로는 등록된 사진을 재사용하기 위함입니다.</p>
                </div>
                <div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <input class="form-control" id="uploadFile" type="file" accept=".xlsx,.xls">
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" value="" id="check-find-photo" checked>
                                    <label class="form-check-label" for="check-find-photo">
                                      상품명으로 사진 자동 검색
                                    </label>
                                  </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
                <button type="button" class="btn btn-primary waves-effect waves-light" id="modal_memberUpload" onclick="uploadProductsExcel()">일괄 등록하기</button>
            </div>
        </div>
    </div>
</div>

<!-- 상품 사진 찾기 -->
<input type="hidden" id="product-SEQ">
<input type="hidden" id="product-code">
<input type="hidden" id="photo-division">
<input type="hidden" id="photo-section">
<div class="modal fade" id="modal-photo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> 상품 사진 찾기</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <h5>상품 명칭으로 검색하여 적절한 사진을 선택하세요</h5>
                    <p class="card-title-desc text-danger">원하는 사진이 없으면 직접 등록하세요.</p>
                </div>
                <div class="row">
                    <div class="col-2">
                        <select id="photo-category-target" class="form-select">
                            <option value="alltok">신선</option>
                            <option value="shuket_bcd">공산</option>
                            <option value="shuket_all">공용 전체</option>
                        </select>                        
                    </div>
                    <div class="col-5">
                        <div class="input-group mb-3">
                            <input type="text" id="photo-tags" class="form-control tagin" data-tagin-separator=" " placeholder="검색 내용을 입력하세요" aria-describedby="btn-search-photo" onkeypress="seachPhotoKeyPress(this)">
                            <button class="btn btn-primary" type="button" id="btn-search-photo" onclick="seachPhoto(1)">찾기</button>
                        </div>

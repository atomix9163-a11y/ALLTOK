    const getLeaftlet = async (leafletCode) => {
        const callApi = `${apiServer}/leaflet/apiGet`;
        const result = axios.post(callApi, {
            leafletCode: leafletCode
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {
            if (response.data.data)
                return response.data.data;
            else
                return null;
        }).catch(error => {
            console.log(error);
            return null;
        })
        return result;
    }


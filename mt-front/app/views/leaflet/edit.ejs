                tempSectionHTML = divContainer.innerHTML;

                let sectionProductHTML_row = "";
                if (section.product.length > 0) {
                    // 페이징 처리. 1페이지
                    const page = 1;
                    const rowPerPage = 9;
                    let targetProducts = section.product.filter(e => e.tmpl_dt_status == 'A');

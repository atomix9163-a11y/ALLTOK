                            <input type="file" name="product-image-upload" id="product-image-upload" class="file_upload" onchange="uploadProductImage(this)" accept=".jpg,.jpeg,.png">
                        </div>
                        <!-- END : Buttons container -->
                    </div>
                </div>               
                <div class="row" >
                    <img id="preview">

                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="mb-3">
                            <div class="row" style="width: 100%; height:510px;overflow: auto;" id="products-photo-list">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">
                        <div class="mb-1">
                            <nav aria-label="Page navigation">
                                <ul class="pagination justify-content-center" id="products-photo-pager"></ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect" onclick="clearProductPhoto()">사진 지우기</button>
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">닫기</button>
            </div>
        </div>
    </div>
</div>

<!-- 템플릿 선택 모달 -->
<div class="modal fade" id="modal-template-select" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_userView_Label">템플릿 선택</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

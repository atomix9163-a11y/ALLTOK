    const updateProductValue = (obj, changeType, sectionCode, productCode) => {
        
        const changedValue = obj.value;
        
        // 대상 데이터 항목을 찾는다
        const sectionInfo = dataJSON.data.section.find(item => item.section == sectionCode);
        const productInfo = sectionInfo.product.find(item => item.tmpl_dt_cd == productCode);
        switch (changeType) {
            case "NAME": 
                const productNameUnit = changedValue.trim().split(" ");
                // console.log(productNameUnit[0], productNameUnit[1])
                // 분리한 맨 뒤가 UNIT
                productInfo.tmpl_dt_unit = productNameUnit.length > 1 ? productNameUnit[productNameUnit.length - 1] : "";
                productInfo.tmpl_dt_tl = productNameUnit.length > 1 ? productNameUnit.slice(0, productNameUnit.length - 1).join(' ') : productNameUnit[0];
                // console.log(productNameUnit.length, productInfo)
                break;
            case "PRICE": productInfo.tmpl_dt_sale_price = changedValue; break;
        }      
        showLeafletAction(true, true);  

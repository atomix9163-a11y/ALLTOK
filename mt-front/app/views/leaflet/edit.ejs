                    targetProducts = (targetProducts.length <= rowPerPage) ? targetProducts : targetProducts.slice(0, 9);
                    const viewMoreFlag = (section.product.length <= rowPerPage) ? false : true;

                    // 보이기 상태인 상품만 목록으로 처리

                    for (let product of targetProducts) {
                        if (product.tmpl_dt_status == 'H') continue;
                        const listPrice = product.tmpl_dt_list_price;
                        const salePrice = product.tmpl_dt_sale_price;

                        let tempProductHTML = (section.useTable) ? sectionProductTableHTML : sectionProductHTML;

                        tempProductHTML = tempProductHTML.replaceAll('${product_name}', product.tmpl_dt_tl);
                        tempProductHTML = tempProductHTML.replaceAll('${product_unit}', product.tmpl_dt_unit);
                        tempProductHTML = tempProductHTML.replaceAll('${product_sale_price}', numeral(salePrice).format("0,0"));
                        if (product.tmpl_dt_img != "") {
                            let imageUri = imageUrilFromProdcut(product);
                            imageUri = convertCloundFront(imageUri)
                            tempProductHTML = tempProductHTML.replaceAll('${product_imageUri}', imageUri);
                        } else {
                            tempProductHTML = tempProductHTML.replaceAll('${product_imageUri}', blankImage);
                        }
                        tempProductHTML = tempProductHTML.replaceAll('${product_action}', `addToCart('${product.tmpl_dt_cd}', '${salePrice}')`);

                        let tempElement = document.createElement("div");
                        tempElement.innerHTML = tempProductHTML;
                        sectionProductHTML_row += tempElement.innerHTML;
                    }
                    sectionProductHTML_row += (viewMoreFlag) ? `<button class='btn btn-light w-100' onclick="javascript:alert('모바일에서 확인하세요')">더보기</button>` : '';
                    tempSectionHTML = tempSectionHTML.replace("$sub{}$sub", sectionProductHTML_row);
                } else {
                    tempSectionHTML = tempSectionHTML.replace("$sub{}$sub", "");
                }
                sectionHTML_row += tempSectionHTML;
            }
        }
        tempHTML = tempHTML.replace("$category{}$category", sectionHTML_row);
        return `<div class="products pt-2 pb-2">${tempHTML}</div>`;
    }


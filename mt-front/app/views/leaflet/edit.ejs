    const saveTimeSetting = async () => {
        let useTimeSetting = document.getElementById("swc-leaflet-range-use").checked;

        const startDateSetting = litepickerStartDate.getDate() ? litepickerStartDate.getDate().format("YYYY-MM-DD") + " " + document.getElementById("dt-leaflet-start-hour").value + ":00:00" : null;
        const endDateSetting = litepickerEndDate.getDate() ? litepickerEndDate.getDate().format("YYYY-MM-DD") + " " + document.getElementById("dt-leaflet-end-hour").value + ":59:59" : null;

        if (useTimeSetting && (!startDateSetting || !endDateSetting)) {
            alert("사용 시간을 설정하려면 반드시 사용 기간을 선택해 주세요");
            return false;
        }

        const callApi = `${apiServer}/leaflet/apiModifyUseTime`
        const result = await axios.post(callApi, {
            leafletCode: leafletCode,
            useTime: (useTimeSetting) ? 'Y' : 'N',
            startDate: startDateSetting,
            endDate: endDateSetting
        }, {
                headers: {
                    xtoken: getCookie("xToken")
                }
        })
        .then(response => {
            if (response.data.data) {                
                // alert(`상태가 저장되었습니다.`);    
                return true;
            } else {
                // alert(`상태 변경에 실패했습니다. 잠시 후 다시 시도해 주십시오.`);    
                return false;
            }
        })
        .catch(error => { 
            console.log(error); 
            return false;
            // alert(`상태 변경에 실패했습니다. 잠시 후 다시 시도해 주십시오.`);
        }) 
        return result;
    }


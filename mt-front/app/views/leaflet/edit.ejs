            if (!sectionData.status || sectionData.status == 'A') {
                // console.log(sectionData)
                // dataSection에 포함된 활성 상품 숫자를 카운트하여 1개 이상일 때만 전달
                const countActive = sectionData.product.filter(item => item.tmpl_dt_status === 'A').length;
                if (countActive > 0) {
                    for (let productData of sectionData.product) {
                        if (productData.tmpl_dt_status == 'A') {
                            if (productData.tmpl_dt_sale_price > 0) {
                                // 기존 단위가 단위 값이 맞는지 확인한다
                                let title = productData.tmpl_dt_tl + ' ' + productData.tmpl_dt_unit;                                
                                const match = title.match(/(\d+(?:\.\d+)?|한|두|세|네|다섯|여섯|일곱|여덟|아홉|열|열한|열둘|열셋|열넷|열다섯|열여섯|열일곱|열여덟|열아홉|스무|스물|서른|마흔|쉰)\s*(개|망|통|단|봉지|봉|팩|포기|근|병|캔|박스|마리|줄|컵|장|g|kg|l|ml)/gi);
                                console.log(match)
                                const standard = match && match[0] ? match[0].trim() : null;                                    

                                qmsyncData.products.push(
                                    {
                                        "name": productData.tmpl_dt_tl + ' ' + productData.tmpl_dt_unit,
                                        "standard": standard,
                                        "price": parseInt(productData.tmpl_dt_sale_price),
                                        // "tax": productData.tmpl_dt_tax ? productData.tmpl_dt_tax == "tax" ? 'tax' : 'free' : 'free',
                                        "imageUrl": getImageUrlFromJsonData(productData.tmpl_dt_img)
                                    }
                                )
                            }
                        }
                    }
                }
            }
        }
        console.log(qmsyncData)
        return;

        console.log("큐마켓 상품 동기화: API 호출")
        // console.log(qmsyncData)
        showSyncProcess();
        await axios.post(qmSyncServer, qmsyncData)
        .then(response => {
            console.log(response)            
            hideSyncProcess();
            alert(`큐마켓 상품이 연동되었습니다.`);
        })
        .catch(error => { 
            hideSyncProcess();
            console.log(error); 
            console.log(error.response); 
            alert(`큐마켓 상품 연동에 실패했습니다. ${error.response.status == 409 ? error.response.data.message : ''}`);
        })
    }

    const showSyncProcess = () => {
        document.getElementById("syncProcess").classList.remove("d-none");
    }

    const hideSyncProcess = () => {
        console.log("hide")
        document.getElementById("syncProcess").classList.add("d-none");
    }

</script>
    const changeTemplate = async () => {
        const selectedTemplateRadio = document.querySelector("[name='rd-select-template']:checked");
        if (selectedTemplateRadio) {
            if (!confirm("템플릿 변경은 즉시 적용됩니다. 계속하시겠습니까?")) return;

            let templateCode = selectedTemplateRadio.value;
            const callApi = `${apiServer}/leaflet/apiUpdateTemplate`
            await axios.post(callApi, {
                leafletCode: leafletCode,
                templateCode: templateCode
            }, {
                    headers: {
                        xtoken: getCookie("xToken")

    const updatePushCount = (maxCount, container, counter) => {
        if (isInit) showLeafletAction(false, false); else  showLeafletAction(true, false);

        const editorElement = document.querySelector(`#${container} .ck-editor__editable_inline`);
        const editorInstance = editorElement.ckeditorInstance;
        const dataText = editorInstance.getData();

        if (container == "push-content-area") {
            dataJSON.data.topNotice = dataText;
        } else {
            dataJSON.data.bottomInfo = dataText;
        }

        let editorCount = fn_checkByteString(dataText);

        if (editorCount > maxCount) {
            document.getElementById(counter).innerHTML = `<span class="text-danger fs-5">${numeral(editorCount).format("0,0")}</span>/${numeral(maxCount).format("0,0")} bytes`;
            return false;
        } else {            
            document.getElementById(counter).innerHTML = `${numeral(editorCount).format("0,0")}/${numeral(maxCount).format("0,0")} bytes`;
            return true;
        }

    // 사용자가 선택한 이미지 파일을 600x600으로 강제 리사이즈해서 업로드한다
    const uploadProductImage = async (obj) => {
        let uploadFile = obj;

        // 이미지를 600x600으로 리사이징
        var reader = new FileReader();
        reader.onload = function (e) {
            var img = document.createElement("img");
            img.onload = async (event) => {
                // Dynamically create a canvas element
                var canvas = document.createElement("canvas");
                // var canvas = document.getElementById("canvas");
                var context = canvas.getContext("2d");

                const MAX_WIDTH = 600;
                const MAX_HEIGHT = 600;
                let width = img.width;
                let height = img.height;
                let left = 0;
                let top = 0;

                // Actual resizing
                if (width > height) {
                    if (width > MAX_WIDTH) {
                        height = height * (MAX_WIDTH / width);
                        width = MAX_WIDTH;
                        top = (MAX_HEIGHT - height) / 2;
                    } else {
                        left = (MAX_WIDTH - width) / 2;
                        top = (MAX_HEIGHT - height) / 2;
                    }
                } else {
                    if (height > MAX_HEIGHT) {
                        width = width * (MAX_HEIGHT / height);
                        height = MAX_HEIGHT;
                        left = (MAX_WIDTH - width) / 2;;
                    } else {
                        left = (MAX_WIDTH - width) / 2;
                        top = (MAX_HEIGHT - height) / 2;
                    }
                }

                canvas.width = MAX_WIDTH;
                canvas.height = MAX_HEIGHT;
                context.fillStyle = "white";
                context.fillRect(0, 0, MAX_WIDTH, MAX_HEIGHT);
                context.drawImage(img, left, top, width, height);
                
                canvas.toBlob(async (blob) => {
                    await uploadBlobToServer(blob)
                    },
                    "image/jpeg",
                    1,
                );

                // // Show resized image in preview element
                // var dataurl = canvas.toDataURL(uploadFile.files[0].type);
                // document.getElementById("preview").src = dataurl;
            }
            img.src = e.target.result;
        }
        reader.readAsDataURL(uploadFile.files[0]);

        
    }


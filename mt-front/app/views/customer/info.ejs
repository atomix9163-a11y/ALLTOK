<%- contentFor('style') %>

<%- contentFor('content') %>
<div class="row">
    <div class="col-md-3">           
        <div class="card">
            <div class="card-body">
                <div class="row border-bottom">
                    <div class="col-md-6 d-flex gap-1 align-items-center">
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="show-deleted" onclick="refreshGroupList()">
                            <label class="form-check-label" for="show-deleted">삭제그룹포함</label>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex gap-1 align-items-center justify-content-md-end mb-3">
                        <button class="btn btn-outline-primary text-nowrap" onclick="addGroup()" >
                            <i class="demo-pli-reload-3 fs-5"></i>
                            <span class="ms-lg-2">새 그룹 만들기</span>
                        </button>
                    </div>
                </div>                
                <div class="list-group list-group-borderless gap-1 mt-1" id="group-list">
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
    </div>

    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h4 class="">고객 목록</h4>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-4">
                        <a href="#" onclick="addMember()" id="btn-addMember" class="btn btn-outline-primary waves-effect waves-light btn-sm d-none">새 고객 등록하기</a>
                        <a href="#" onclick="addMemberExcelView()" id="btn-addMemberExcel"  class="btn btn-outline-primary waves-effect waves-light btn-sm d-none">대량 등록하기</a>
                    </div>
                    <div class="col-md-2">
                        <input type="text" class="form-control form-control-sm" id="find-phone" placeholder="뒷자리 4개" onkeypress="searchCustomerKey(event)">
                    </div>
                    <div class="col-md-2">
                        <a href="#" onclick="searchCustomer()" id="btn-addMemberExcel"  class="btn btn-outline-primary waves-effect waves-light btn-sm"><i class="bx bx-search-alt-2 me-1 align-middle"></i> 찾기</a>
                    </div>
                </div>         

                <div class="tab-pane active" id="about" role="tabpanel">                   
                    <div class="table-responsive">
                        <table class="table table-sm fs-7 table-nowrap table-hover mb-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">번호</th>
                                    <th scope="col">등록일</th>
                                    <th scope="col">비고</th>
                                    <th scope="col"></th>
                                </tr>
                            </thead>
                            <tbody id="group-member-list">
                            </tbody>
                        </table>
                        <nav aria-label="Page navigation example">
                            <ul class="pagination justify-content-center" id="group-member-pager"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modal-groupView" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered modal-xs">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_userView_Label"> 그룹 관리</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="group-seq">
                <input type="hidden" id="group-code">
                <input type="hidden" id="group-storeCode">
                <div class="text-center mb-4">
                    <h5>주소록 그룹 정보</h5>                    
                </div>
                <div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <label for="group-name" class="form-label">그룹 이름 :</label>
                                <input type="text" class="form-control" placeholder="그룹 이름을 입력하세요" id="group-name" name="group-name">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect waves-light" onclick="updateGroup()">저장하기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<!-- Modal -->
<div class="modal fade" id="modal-memberView" tabindex="-1" aria-labelledby="modal-memberView_Label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_userView_Label"> 고객 관리</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="member_store_seq">
                <input type="hidden" id="member-store-code">
                <input type="hidden" id="member_marto_code">
                <input type="hidden" id="member_marto_API_key">
                <div class="text-center mb-4">
                    <h5>개별 고객 번호 등록</h5>                    
                </div>
                <div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <label for="member-phone" class="form-label">핸드폰 번호 :</label>
                                <input type="text" class="form-control" placeholder="핸드폰 번호를 입력하세요" id="member-phone" name="member-phone" maxlength="15">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect waves-light" onclick="updateMember()">저장하기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<!-- Modal -->
<div class="modal fade" id="modal-memberUpload" tabindex="-1" aria-labelledby="modal-memberUpload_Label" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modal_userView_Label">고객 일괄 업로드</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="text-center mb-4">
                    <p class="card-title-desc">고객을 엑셀 파일을 통해 업로드하는 기능입니다.</p>
                </div>
                <div>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="mb-3">
                                <label for="uploadFile" class="form-label">전화번호만 나열된 엑셀 파일을 이용하세요. <a href="/assets/files/phone.xlsx" target="_blank">phone.xlsx</a></label>
                                <input class="form-control" id="uploadFile" type="file" accept=".xlsx">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect waves-light" id="modal-memberUpload" onclick="uploadMember()">대량 등록하기</button>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<!-- Modal -->
<div class="modal fade" id="modal-sendProcess" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header text-center">
                <h5 class="modal-title" id="staticBackdropLabel">고객 데이터 업데이트 중</h5>
            </div>
            <div class="modal-body text-center">
                <p>고객 데이터 업데이트 중입니다. </p>
                <p><img src="/assets/img/alltok/mail-send.gif"></p>
                <p>작업이 완료되면 자동으로 닫히므로 잠시 기다려 주십시오.</p>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<%- contentFor('script') %>
<script>
    const storeCode = '<%=storeInfo.store_code %>';
    let currentPage = 1;
    const rowCount = 20;
    let selectedGroupCode = '';    

    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        const modalGroupView = document.getElementById('modal-groupView')
        modalGroupView.addEventListener('shown.bs.modal', event => {
            document.getElementById("group-name").focus();
        })

        await refreshGroupList();
        // console.log(firstGroup)
        makeNumberInput(["member-phone"]);
    })

    const refreshGroupList = async () => {
        const firstGroup = await getGroupList();
        if (firstGroup) {
            showCustomer(document.getElementById(`group-list-${firstGroup.group_code}`), firstGroup.group_code, 1);
        }
    }

    
    const buildGroupHTML = (groupCode, groupName, memberCount, isActive) => {
        return `<a href="javascript:void(0)" class="list-group-item list-group-item-action ${isActive ? 'active' : ''}" id="group-list-${groupCode}" onclick="showCustomer(this,'${groupCode}', 1)">
                    <i class="demo-pli-male-female fs-5 me-2"></i> <span class='list-group-item-name'>${groupName}</span>
                    <span class="badge bg-danger rounded-pill ms-auto">${numeral(memberCount).format('0,00')}</span>
                    <button type="button" class="btn btn-xs btn-outline-light btn-group-modify" onclick="modifyGroup('${groupCode}')">변경</button>
                    <button type="button" class="btn btn-xs btn-outline-danger btn-group-delete" onclick="removeGroup('${groupCode}')">삭제</button>
                </a>`
    }

    const buildDeletedGroupHTML = (groupCode, groupName, memberCount, isActive) => {
        return `<a href="javascript:void(0)" class="list-group-item list-group-item-action ${isActive ? 'active' : ''}" id="group-list-${groupCode}" onclick="showCustomer(this,'${groupCode}', 1)">
                    <i class="demo-pli-male-female fs-5 me-2"></i> <span class='list-group-item-name'>${groupName}</span>
                    <span class="badge bg-danger rounded-pill ms-auto">${numeral(memberCount).format('0,00')}</span>
                    <button type="button" class="btn btn-xs btn-outline-success btn-group-recover" onclick="reviveGroup('${groupCode}')">복구</button>
                </a>`
    }

    const getGroupList = async () => {
        const showDeleted = document.getElementById("show-deleted").checked;
        let callApi = `${apiServer}/customer/apiGroupList`;
        let firstGroup = await axios.post(callApi, {
            storeCode: storeCode,
            showDeleted: showDeleted
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {
            let html = "";
            if (response.data.result && response.data.data) {
                for (let group of response.data.data) {
                    html += (group.active == 'A') ?
                        buildGroupHTML(group.group_code, group.name, group.member_count, false):
                        buildDeletedGroupHTML(group.group_code, group.name, group.member_count, false);
                }
            }
            document.getElementById("group-list").innerHTML = html;
            return (response.data.data) ? response.data.data[0] : null;
        }).catch(error => { 
            console.log(error); 
            alert(`발송 목록을 가져올 때 오류가 발생했습니다. 잠시 후 다시 시도하거나 문의하여 주십시오.`);
            return null;
        });
        return firstGroup;
    }

    async function searchCustomerKey(e) {
        if (e.keyCode == 13) searchCustomer();
    }

    async function searchCustomer() {
        if (selectedGroupCode == "") return;
        currentPage = 1;
        await showCustomer(null, selectedGroupCode, currentPage, true);
    }

    async function showCustomer(obj, groupCode, page, isFind = false) {
        if (obj) {
            document.querySelectorAll("#group-list a").forEach(item => item.classList.remove("active"));
            // 그룹 목록에서 클릭한 것이면 해당 엘리먼트를 active
            obj.classList.add("active")
        }
        selectedGroupCode = groupCode; // 멤버 추가를 위해 변수에 보관       

        if (page == 1 && !isFind) {
            document.getElementById("find-phone").value = "";
            document.getElementById(`btn-addMember`).classList.remove("d-none");
            document.getElementById(`btn-addMemberExcel`).classList.remove("d-none");
        }
        const searchKey = document.getElementById("find-phone").value;
        let callApi = `${apiServer}/customer/apiGroupMembers`;
        let totalCount = await axios.post(callApi, {
            groupCode: groupCode,
            phone: searchKey,
            page: page,
            rowCount : rowCount
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {
            // console.log(response)
            if (response.data.result && response.data.data) {
                let customerHTML = "";
                let num = response.data.data.count - (page - 1) * rowCount;
                for (let customer of response.data.data.rows) {
                    customerHTML += `<tr>
                        <td>${num--}</td>
                        <td>${maskPhoneNumber(customer.phone)}</td>
                        <td>${moment(customer.C_TIME).format('YYYY-MM-DD hh:mm:ss')}</td>
                        <td>${customer.phone_length > 11 ? "전화번호 길이가 11자를 넘습니다." : customer.phone_length < 11 ? '전화번호 길이가 11자보다 짧습니다.' : ''}</td>
                        <td><button type="button" class="btn btn-xs btn-outline-danger waves-effect waves-light" onclick='removeMember("${groupCode}", "${customer.seq}")'>삭제</button></td>
                    </tr>`
                }
                document.getElementById("group-member-list").innerHTML = customerHTML;

                let pagerHTML = createPagerHTML(response.data.data.count, rowCount, page, 10, "changePage");
                document.getElementById("group-member-pager").innerHTML = pagerHTML;

                return response.data.data.count;
            } else {
                return 0;
            }
        })
        .catch(error => { console.log(error); alert(`그룹 멤버 정보를 가져오지 못했습니다.`); return 0;});
        return totalCount;
    }

    function changePage(page, rowPerPage) {
        // self.location.href = "/customers/info?page=" + page;
        showCustomer(null, selectedGroupCode, page, true)
    }

    function addGroup() {
        document.getElementById("group-seq").value = "";
        document.getElementById("group-code").value = "";
        document.getElementById("group-storeCode").value = storeCode;
        document.getElementById("group-name").value = "";

        const modal = new bootstrap.Modal(document.getElementById('modal-groupView'));
        modal.show();    
    }

    async function modifyGroup(groupCode) {
        // 정보를 얻어온다        
        await axios.post(`${apiServer}/customer/apiGetGroup`, {
            groupCode: groupCode
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {
            // console.log(response)
            if (response.data.result && response.data.data) {
                let groupInfo = response.data.data;                
                document.getElementById("group-seq").value = groupInfo.seq;
                document.getElementById("group-code").value = groupInfo.group_code;
                document.getElementById("group-storeCode").value = groupInfo.store_code;
                document.getElementById("group-name").value = groupInfo.name;

                const modal = new bootstrap.Modal(document.getElementById('modal-groupView'));
                modal.show();
            } else {
                alert("그룹 정보를 읽지 못했습니다.");
            }
        })
        .catch(error => { console.log(error); alert("그룹 정보를 읽지 못했습니다.");});
    }

    function validation(name) {
        if (name.length == 0) {
            alert("그룹 이름을 입력해야만 합니다.");
            return false;
        }
        return true;
    }

    async function updateGroup() {
        let groupCode = document.getElementById("group-code").value;
        let name = document.getElementById("group-name").value.trim();

        if (!validation(name)) return;

        let callApi = apiServer + ((groupCode == "") ? "/customer/apiCreateGroup" : "/customer/apiUpdateGroup");
        // 정보를 업데이트        
        await axios.post(callApi, {
            groupCode: groupCode, 
            storeCode: storeCode,
            name: name, 
            sendType: 'N'
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {
            if (response.data.result && response.data.data) {
                switch (response.data.data) {
                    case 0:
                        alert("데이터 오류로 그룹 추가가 실패했습니다. 잠시 후 다시 시도해 주십시오.");
                        break;
                    default:
                        let modal = bootstrap.Modal.getInstance(document.getElementById('modal-groupView'));
                        modal.hide();

                        if (groupCode == "") {
                            document.querySelectorAll("#group-list a").forEach(item => item.classList.remove("active"));
                            // add success
                            document.getElementById("group-list").innerHTML += buildGroupHTML(response.data.data, name, 0, true);
                            showCustomer(null, response.data.data, 1);
                        } else {
                            // update sucess
                            document.querySelector(`#group-list-${groupCode} .list-group-item-name`).innerText = name;
                        }
                }
            } else {
                alert(`그룹 정보를 ${(seq == "") ? "추가" : "변경"}하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`그룹 정보를 ${(groupCode == "") ? "추가" : "변경"}하지 못했습니다.`);});
    }

    const removeGroup = async (groupCode) => {
        let callApi = apiServer + "/customer/apiRemoveGroup";
        // 정보를 업데이트        
        await axios.post(callApi, {
            groupCode: groupCode
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(async response => {
            if (response.data.result && response.data.data) {
                // self.location.reload();
                await refreshGroupList();
            } else {
                alert(`그룹 정보를 삭제하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`그룹 정보를 삭제하지 못했습니다.`);});
    }

    const reviveGroup = async (groupCode) => {
        let callApi = apiServer + "/customer/apiReviveGroup";
        // 정보를 업데이트        
        await axios.post(callApi, {
            groupCode: groupCode
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(async response => {
            if (response.data.result && response.data.data) {
                // self.location.reload();
                await refreshGroupList();
            } else {
                alert(`그룹 정보를 복구하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`그룹 정보를 복구하지 못했습니다.`);});
    }


    // 대상 그룹의 멤버 숫자를 변경
    const updateGroupMemberCount = (groupCode) => {
        let callApi = `${apiServer}/customer/apiGroupMemberCount`;
        // 정보를 업데이트        
        axios.post(callApi, {
            groupCode: groupCode
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {
            if (response.data.result && response.data.data) {
                document.querySelector(`#group-list-${groupCode} span.badge`).innerHTML = numeral(response.data.data).format("0,0");
            }
        })
        .catch(error => { console.log(error); });
    }

    const addMember = (seq, store_code, marto_code, marto_API_key) => {
        document.getElementById("member-store-code").value = store_code;        
        document.getElementById("member-phone").value = "";

        const modal = new bootstrap.Modal(document.getElementById('modal-memberView'));
        modal.show();
    }

    const validation_member = (phone) => {
        if (phone.length == 0) {
            alert("고객 번호를 입력해야만 합니다.");
            return false;
        }
        return true;
    }

    const updateMember = async () => {
        let phone = document.getElementById("member-phone").value.trim();

        if (!validation_member(phone)) return;

        let callApi = `${apiServer}/customer/apiAddMember`;
        // 정보를 업데이트        
        await axios.post(callApi, {
            storeCode: storeCode,
            groupCode: selectedGroupCode, 
            phone: phone
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(response => {
            if (response.data.result && response.data.data) {
                // console.log(returnResult)
                switch (response.data.data) {
                    case 999:
                        alert("네트워크 오류로 고객 등록이 실패했습니다. 잠시 후 다시 시도해 주십시오.");
                        break;
                    case -1:
                        alert("이미 등록되어 있는 고객입니다.");
                        break;
                    case 0:
                        alert("데이터 오류로 고객 등록이 실패했습니다. 잠시 후 다시 시도해 주십시오.");
                        break;
                    default:
                        let modal = bootstrap.Modal.getInstance(document.getElementById('modal-memberView'));
                        modal.hide();
                        showCustomer(null, selectedGroupCode, 1);
                        updateGroupMemberCount(selectedGroupCode)
                }
            } else {
                alert(`고객 정보를 추가하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`고객 정보를 추가하지 못했습니다.`);});
    }

    const removeMember = async (groupCode, phoneSeq) => {
        if (!confirm("삭제한 고객은 되살릴 수 없습니다. 계속하시겠습니까?")) return;
        let callApi = `${apiServer}/customer/apiRemoveMemberSeq`;
        // 정보를 업데이트        
        await axios.post(callApi, {
            storeCode: storeCode,
            groupCode: groupCode, 
            seq: phoneSeq
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        })
        .then(async response =>  {
            if (response.data.result && response.data.data) {
                
                switch (response.data.data) {
                    case 999:
                        alert("네트워크 오류로 고객 삭제가 실패했습니다. 잠시 후 다시 시도해 주십시오.");
                        break;
                    case 0:
                        alert("데이터 오류로 고객 삭제가 실패했습니다. 잠시 후 다시 시도해 주십시오.");
                        break;
                    default:
                        showCustomer(null, selectedGroupCode, 1);
                        updateGroupMemberCount(selectedGroupCode);
                }
            } else {
                alert(`고객 정보를 삭제하지 못했습니다.`);
            }
        })
        .catch(error => { console.log(error); alert(`고객 정보를 삭제하지 못했습니다.`);});
    }

    const addMemberExcelView = () => {
        document.getElementById("uploadFile").value = null;
        const modal = new bootstrap.Modal(document.getElementById('modal-memberUpload'));
        modal.show();
    }

    async function uploadMember() {
        const formData = new FormData();
        formData.append("uploadFile", uploadFile.files[0]);
        formData.append("location", "members");

        const modal_sendProcess = new bootstrap.Modal(document.getElementById('modal-sendProcess'));
        modal_sendProcess.show();

        await axios.post(`${apiServer}/upload/uploadSingle`, formData, {
            headers: {
                "Content-Type": "multipart/form-data",
            },
        })
        .then(async response =>  {
            if (response.data.result === "success") {
                // 업로드한 파일로 업데이트 실시
                // console.log(response.data);
                setTimeout(function() {
                    let modal_sendProcess = bootstrap.Modal.getInstance(document.getElementById('modal-sendProcess'));
                    modal_sendProcess.hide();
                }, 1000)

                await axios.post(`${apiServer}/customer/apiUploadExcel`, {
                    storeCode: storeCode,
                    groupCode: selectedGroupCode,
                    file: response.data.data.filename,
                    path: response.data.data.path
                }, {
                    headers: {
                        xtoken: getCookie("xToken"),
                        location: 'uploadFiles/members'
                    }
                }).then(async response => {
                    if (response.data.result) {
                        let modal = bootstrap.Modal.getInstance(document.getElementById('modal-memberUpload'));
                        modal.hide();

                        setTimeout(async () => {
                            showCustomer(null, selectedGroupCode, 1);
                            updateGroupMemberCount(selectedGroupCode);
                        }, 1000)
                    } else {
                        alert("엑셀 다량 등록이 실패했습니다. 파일 형식 또는 구조를 확인해 주세요.");        
                    }                    
                })

                // tempJson.presenter1.photo = response.data.data;
            } else {
                alert("파일 업로드를 실패했습니다.");
                return null;
            }
        });
    }
</script>
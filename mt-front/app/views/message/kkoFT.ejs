<%- contentFor('style') %>

<%- contentFor('content') %>
<div class="row mb-5">
    <div class="col-xxl-6 col-md-4">

        <div class="card">
            <div class="card-header">
                <div class="row">
                    <h4 class="card-title col-md-3">필수 1. <span>발송 내용</span> <em>*</em></h4>
                    <div class="col-md-9 form-switch form-switch-sm" id="use-alternative-send-check">
                        <input class="form-check-input" type="checkbox" id="use-alternative-send" checked onchange="useInsteadSend()">
                        <label class="form-check-label fs-7" for="use-alternative-send">대체 SMS/LMS 문자 발송</label>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row justify-content-end">
                    <div class="col-md-5" id="at-text-area">
                        카카오 내용
                        <textarea class="form-control form-control-sm mb-2" id="kakao-text" rows="14"></textarea>
                        <div class="badge rounded-pill bg-dark float-end" role="alert" id="kakao-text-count">0/1000 byte</div>
                    </div>
                    <div class="col-md-5" id="sms-text-area">
                        <div class="row">
                            <div class="col-md-6">대체 문자: <span class="fs-7">[Web발송]</span></div>
                            <div class="col-md-3 form-switch form-switch-sm">
                                <input class="form-check-input" type="checkbox" id="use-lms" checked onchange="useLMS()">
                                <label class="form-check-label fs-7" for="use-lms">LMS</label>
                            </div>
                            <div class="col-md-3 text-end">
                                <button class="btn btn-xs gadient-violet-hor" type="button" onclick="copyKakaoText()">복사</button>
                            </div>
                        </div>
                        <textarea class="form-control form-control-sm mb-2" id="sms-text" rows="14"></textarea>
                        <div class="badge rounded-pill bg-dark float-end" role="alert" id="sms-text-count">0/1000 byte</div>
                    </div>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->

        <div class="card">
            <div class="card-header">
                <h4 class="card-title">선택 2. <span>대체 발송 웹주문 링크 사용</span> <em>*</em></h4>
            </div>
            <div class="card-body">
                <div class="row justify-content-end">
                    <div class="col-md-4 form-switch form-switch-md">                        
                        <input class="form-check-input" type="checkbox" id="use-web-link" checked="">
                        <label class="form-check-label" for="use-web-link">사용</label>            
                    </div>
                    <div class="col-md-6">
                        <input type="text" class="form-control" placeholder="Web 주문 경로" id="web-link" readonly />
                    </div>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->

        <div class="card">
            <div class="card-header">
                <h4 class="card-title">선택 3. <span>발송 유형 선택</span> <em>*</em></h4>
            </div>            
            <div class="card-body">
                <div class="row justify-content-end">
                    <div class="col-md-4">                        
                        <input type="radio" class="btn-check" name="send-type" id="send-type-I" autocomplete="off" checked onclick="changeSendTime(this)">
                        <label class="btn btn-sm btn-outline-shuket-purple" for="send-type-I">즉시발송</label>

                        <input type="radio" class="btn-check" name="send-type" id="send-type-R" autocomplete="off"  onclick="changeSendTime(this)">
                        <label class="btn btn-sm btn-outline-shuket-purple" for="send-type-R">예약발송</label>
                    </div>
                    <div class="col-md-3"><input class="form-control form-control-sm d-none" id="send-reserve-date" type="date"></div>
                    <div class="col-md-3"><input class="form-control form-control-sm d-none" id="send-reserve-time" type="time"></div>
                </div>                        
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h4 class="card-title">선택 4. <span>발송 대상 그룹</span> <em>*</em></h4>
            </div>
            <div class="card-body">
                <div class="row justify-content-end">
                    <div class="col-md-10 ">
                        <table class="table table-sm table-nowrap table-hover mb-0 table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">선택</th>
                                    <th scope="col">그룹명</th>
                                    <th scope="col">고객수</th>
                                </tr>
                            </thead>
                            <tbody id="group_member_list">
                                <% for (let group of groupList) { %>
                                    <tr>
                                        <td class="text-center"><input class="form-check-input groupCheck" type="checkbox" value="<%=group.group_code %>" name="groupCheck" id="groupCheck-<%=group.seq %>"></td>
                                        <td><label class="form-check-label" for="groupCheck-<%=group.seq %>"><%=group.name %></label></td>
                                        <td class="text-center"><%=numeral(group.member_count).format('0,0') %></td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->

        <div class="row justify-content-center">
            <div class="col-md-6">
                <button class="btn gadient-violet-hor" type="button" onclick="send_ft()">발송하기</button>
            </div>
        </div>
    </div>

    <div class="col-xxl-3 col-md-4">
        <p>친구톡 미리보기</p>
        <div class="phone phone-kakaoFT mb-3">
            <div class="review" id="review"></div>
        </div>
        <div class="row">
            <div class="col-md-8 fs-7">
                <em>* 미리보기 화면은 참고용으로, 폰마다 보여지는 모습이 다를 수 있습니다.</em>
            </div>
        </div>
    </div>

    <div class="col-xxl-3 col-md-4" id="review-text-area">
        <p>대체 메시지 미리보기</p>
        <div class="phone mb-3">
            <div class="review" id="review-text"></div>
        </div>
        <div class="row">
            <div class="col-md-8 fs-7">
                <em>* 미리보기 화면은 참고용으로, 폰마다 보여지는 모습이 다를 수 있습니다.</em>
            </div>
        </div>
    </div>
</div>
<div class="row">

    <div class="col-xxl-6">
        <div class="card">
            <h5 class="card-header bg-transparent border-bottom text-uppercase">주의사항</h5>
            <div class="card-body">
                <p class="card-text">
                    금칙어를 사용하는 경우 통신사의 정책에 따라 스팸문자로 분류되어 고객문자의 스팸문자함으로 자동 분류되는 경우가 발생 됩니다. 
                </p>
                <p class="card-text">
                    금칙어 사용으로 고객이 문자를 받지 못하는 경우 당사는 책임이 없음을 알려 드립니다.
                </p>
                <p class="card-text text-danger">
                    (금칙어 : 대방출, 완전무료, 특가, 초특가, 파격, 대박, 대표, 완전무료, 최저가, 폭탄가, 365연중무휴, 세일, 특선 등/특수문자◎, ※, ★ .. <, > )
                </p>
            </div>
        </div>
    </div>
    <div class="col-xxl-6">
        <div class="card">
            <h5 class="card-header bg-transparent border-bottom text-uppercase">마케팅(광고) 수신동의철회 안내</h5>
            <div class="card-body">
                <p class="card-text">
                    2014년 11월 시행된 정보통신법망법에 따라 광고성 정보 전송자는 수신동의 일로부터 2년마다 수신자에게 수신동의 여부 확인 안내를 해야 합니다. 
                </p>
                <ul>
                    <li>전송자의 명칭</li>
                    <li>수신동의 날짜</li>
                    <li>철회의사를 표시하는 방법으로 명시하여야 합니다.</li>
                </ul>
                <p class="card-text">
                    위반 시 관련법에 따라 3,000만원 이하의 과태료가 부과될 수 있습니다.
                </p>
                <p class="card-text">
                    당사는 사용 상 부주의에 의한 과태료에 대해 책임이 없음을 알려 드립니다.
                </p>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="modal-sendProcess" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header text-center">
                <h5 class="modal-title" id="staticBackdropLabel">메시지 발송 중</h5>
            </div>
            <div class="modal-body text-center">
                <p>메시지가 발송 중입니다. </p>
                <p><img src="/assets/images/mail-send.gif"></p>
                <p>발송이 완료되면 자동으로 닫히므로 잠시 기다려 주십시오.</p>
            </div>
        </div>
    </div>
</div>
<!-- end modal -->

<%- contentFor('script') %>
<script src="/assets/js/message-helper.js"></script>

<script>
    const apiServer = '<%=apiServer %>';
    const storeCode = '<%=user.store_code %>';
    const M_MOA_CODE = '<%=storeInfo.M_MOA_CODE %>';
    let service = {
        shuketPush: '<%=storeInfo.service.SHUKET_PUSH %>',
        shuketMobile: '<%=storeInfo.service.SHUKET_MOBILE %>',
        shortUri: '<%=(storeInfo.service.SHOP_SHORT_URL) ? storeInfo.service.SHOP_SHORT_URL : "" %>',
        useFT: '<%=storeInfo.service.FT %>',
        unitPriceFT: '<%=storeInfo.service.UP_FT %>',
        useAT: '<%=storeInfo.service.AT %>',
        unitPriceAT: '<%=storeInfo.service.UP_AT %>',
        useRCSSMS: '<%=storeInfo.service.RCSSMS %>',
        unitPriceRCSSMS: '<%=storeInfo.service.UP_RCSSMS %>',
        useRCSLMS: '<%=storeInfo.service.RCSLMS %>',
        unitPriceRCSLMS: '<%=storeInfo.service.UP_RCSLMS %>',
        useSMS: '<%=storeInfo.service.SMS %>',
        unitPriceSMS: '<%=storeInfo.service.UP_SMS %>',
        useLMS: '<%=storeInfo.service.LMS %>',
        unitPriceSMS: '<%=storeInfo.service.UP_LMS %>',
        kakaoChannel: '<%=storeInfo.service.kakao_channel %>'
    }
    let kakaoFTmax = 1000;
    let smsMax = 1000;

    // <!-- 페이지 로드 완료 시 실행 -->
    document.addEventListener("DOMContentLoaded", async function(){
        document.getElementById("kakao-text").addEventListener("keyup", updateKakaoReview);
        document.getElementById("sms-text").addEventListener("keyup", updateTextReview);
        document.getElementById("use-web-link").addEventListener("change", updateUrlReview);

        if (service.shortUri) {
            document.getElementById("web-link").value = service.shortUri;
        } else {
            document.getElementById("web-link").value = (service.shuketMobile == 'Y') ? `http://shop.toktokking.kr/${M_MOA_CODE}` : `http://shop.toktokking.co.kr/${storeCode}`;
        }

        if (service.useSMS == 'Y' || service.useLMS == 'Y') {
            document.getElementById("sms-text").addEventListener("keyup", updateTextCount);

            if (service.useSMS == 'Y' && service.useLMS == 'N') {
                document.getElementById("use-lms").checked = false;
                document.getElementById("use-lms").setAttribute("disabled", "");
                smsMax = 80;
            } else if (service.useSMS == 'N' && service.useLMS == 'Y') {
                document.getElementById("use-lms").checked = true;
                document.getElementById("use-lms").setAttribute("disabled", "");
                smsMax = 1000;
            }
        } else {
            document.getElementById("use-alternative-send").checked = false;
            document.getElementById("use-alternative-send-check").classList.add("d-none");
            document.getElementById("review-text-area").classList.add("d-none");            
            setInsteadSend(false);
        } 

        updateKakaoCount();
        updateTextCount();
        updateUrlReview();
    })

    function updateKakaoReview() {
        document.getElementById("review").innerHTML = document.getElementById("kakao-text").value.replaceAll("\n", "<br />");
        updateKakaoCount();
    }

    function updateTextReview() {
        let reviewText = document.getElementById("sms-text").value.replaceAll("\n", "<br />");
        reviewText += (document.getElementById("use-web-link").checked) ? `<br/><span class='review-link'>${document.getElementById("web-link").value}</span>` : "";

        document.getElementById("review-text").innerHTML = reviewText;
        updateTextCount();   
    }

    function copyKakaoText() {
        document.getElementById("sms-text").value = document.getElementById("kakao-text").value;
        updateTextReview();        
    }

    function useInsteadSend() {
        const useAlternativeSend = document.getElementById("use-alternative-send").checked;
        setInsteadSend(useAlternativeSend);
    } 

    function setInsteadSend(useFlag) {
        if (useFlag) {
            document.getElementById("at-text-area").classList.remove("col-md-10")
            document.getElementById("at-text-area").classList.add("col-md-5");
            document.getElementById("sms-text-area").classList.remove("d-none");
        } else {
            document.getElementById("at-text-area").classList.remove("col-md-5");
            document.getElementById("at-text-area").classList.add("col-md-10");
            document.getElementById("sms-text-area").classList.add("d-none");
        }
    }

    function useLMS() {
        const useLMS = document.getElementById("use-lms").checked;
        if (useLMS) {
            smsMax = 1000;
        } else {
            smsMax = 80;
        }
        updateTextCount();
    }

    function updateUrlReview() {
        let messageText = document.getElementById("kakao-text").value;

        let review = messageText.replaceAll("\n", "<br />")
        let review_text = document.getElementById("sms-text").value.replaceAll("\n", "<br />")

        // 버튼 처리
        // let buttonHTML = "";
        // if (template.buttons) {
        //     for (let button of template.buttons) {
        //         buttonHTML += `<br />
        //                 <div class="row mt-2 justify-content-center">
        //                     <button type='button' class='col-md-11 btn btn-sm btn-kakao'>${button.name}</button>
        //                 </div>`;
        //     }
        // }
        if (document.getElementById("use-web-link").checked) {
            review_text += "<br />" + document.getElementById("web-link").value;
        }
        // review += buttonHTML;
        document.getElementById("review").innerHTML = review;
        document.getElementById("review-text").innerHTML = review_text;
    }
    
    function updateKakaoCount() {
        let textCount = fn_checkByte(document.getElementById("kakao-text"));        

        if (textCount > kakaoFTmax) {
            document.getElementById("kakao-text-count").innerHTML = `<span class="text-danger fs-5">${textCount}</span>/${kakaoFTmax} bytes`;
            return false;
        } else {
            updateUrlReview();
            document.getElementById("kakao-text-count").innerHTML = `${textCount}/${kakaoFTmax} bytes`;
            return true;
        }
    }
        
    function getSMSText() {
        let messageSMSText = document.getElementById("sms-text").value;

        if (document.getElementById("use-web-link").checked) {
            messageSMSText += "\n" + document.getElementById("web-link").value;
        }

        return messageSMSText;
    }

    function updateTextCount() {
        let textCount = fn_checkByteString(getSMSText()); // 8 바이트는 [Web발신]
        // let textCount = fn_checkByte(document.getElementById("sms-text")) + 10;        

        if (textCount > smsMax) {
            document.getElementById("sms-text-count").innerHTML = `<span class="text-danger fs-5">${textCount}</span>/${smsMax} bytes`;
            return false;
        } else {
            updateUrlReview();
            document.getElementById("sms-text-count").innerHTML = `${textCount}/${smsMax} bytes`;
            return true;
        }
    }

    function changeSendTime(obj) {
        let id = obj.id;
        if (id == "send-type-R") {
            var d = new Date();
            document.getElementById("send-reserve-date").value = [d.getFullYear(), (d.getMonth() + 1).AddZero(), d.getDate().AddZero()].join('-');
            document.getElementById("send-reserve-time").value = [d.getHours().AddZero(),(d.getMinutes()).AddZero()].join(':')
            document.getElementById("send-reserve-date").classList.remove("d-none");
            document.getElementById("send-reserve-time").classList.remove("d-none");
        } else {
            document.getElementById("send-reserve-date").classList.add("d-none");
            document.getElementById("send-reserve-time").classList.add("d-none");
        }
    }
        
    function checkSendLength() {
        // 길이 체크

        let kakaocheck = updateKakaoCount();        
        if (!kakaocheck) {
            alert(`친구톡 메시지가 ${kakaoFTmax}자를 넘습니다. 내용을 줄여 주시기 바랍니다.`);
            return false;
        }

        let smscheck = updateTextCount();        
        if (!smscheck) {
            alert(`대체 SMS 메시지가 ${smsMax}자를 넘습니다. 내용을 줄여 주시기 바랍니다.`);
            return false;
        }

        return true;
    }

    function validation(kkoContent, targetGroups, sendType, reserveTime) {
        
        if (kkoContent.length == 0) {
            alert("친구톡 내용이 작성되지 않았습니다.");
            return false;
        }
        if (targetGroups.length == 0) {
            alert("발송할 대상이 선택되지 않았습니다.");
            return false;
        }
        let today = new Date();
        let reserveDate = new Date(reserveTime);
        var diffTime = (reserveDate.getTime() - today.getTime()) / (1000*60);
        if (sendType == "R" && diffTime < 30) {
            alert("예약 발송이 선택되었지만 30분 이내 발송하도록 선택되었습니다.");
            return false;
        }
        return true;
    }

    async function send_ft2() {
        if (!checkSendLength()) return;

        const msgType = "AT";

        const kkoContent = document.getElementById("kakao-text").value;
        // const content = document.getElementById("sms-text").value;
        const sms_content = getSMSText();
        const groups = document.querySelectorAll("input[name='groupCheck']:checked");
        let target = [];
        for (group of groups) {
            target.push(`'${group.value}'`);
        }
        const targetGroups = target.join(",");
        const useWebLink = document.getElementById("use-web-link").checked;
        const sendType = (document.getElementById("send-type-I").checked) ? "I" : "R";
        const reserveTime = document.getElementById("send-reserve-date").value + " " + document.getElementById("send-reserve-time").value;

        if (!validation(kkoContent, content, targetGroups, sendType, reserveTime)) return;

        const modal_sendProcess = new bootstrap.Modal(document.getElementById('modal-sendProcess'));
        modal_sendProcess.show();

        let callApi = `${apiServer}/message/apiSendKAKAO_FT`;
        await axios.post(callApi, {
            store_code: '<%=user.store_code %>',
            msgType: msgType,
            kkoContent: kkoContent,
            content: content,
            buttons: "",
            images: "",
            targetGroups: targetGroups,
            useWebLink: useWebLink,
            sendType: sendType, // i 즉시 R 예약
            reserveTime: reserveTime
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {
            // console.log(returnResult)
            setTimeout(function() {
                let modal_sendProcess = bootstrap.Modal.getInstance(document.getElementById('modal-sendProcess'));
                modal_sendProcess.hide();
            }, 1000)

            if (response.data.result && response.data.data.returnCode == 0) {
                if (sendType == "I") {
                    alert(`카카오 친구톡이 발송되었습니다.`);
                } else {
                    alert(`카카오 친구톡 발송이 예약되었습니다. 예약된 알림톡은 발송 내역에서 취소할 수 있습니다.`);
                }
            } else {
                alert(`카카오 친구톡 발송이 실패했습니다: ${response.data.data.returnMessage}`);
            }
        })
        .catch(error => { 
            setTimeout(function() {
                let modal_sendProcess = bootstrap.Modal.getInstance(document.getElementById('modal-sendProcess'));
                modal_sendProcess.hide();
            }, 1000)

            console.log(error); 
            alert(`카카오 친구톡 발송에 실패했습니다.`);
        });
    }

    async function send_ft() {
        if (!checkSendLength()) return;

        // 발송 프로세스 코드 얻기
        // useAT, useFT, useRCSSMS, useRCSLMS, useSMS, useLMS
        let mpCode = getMessagePolicyCode(false, true, false, false, 
            document.getElementById("use-alternative-send").checked && !document.getElementById("use-lms").checked, 
            document.getElementById("use-alternative-send").checked && document.getElementById("use-lms").checked);

        let msgData = {
            pushSendType: (document.getElementById("send-type-I").checked) ? "I" : "S", // i 즉시 S 예약
            sendType: (document.getElementById("send-type-I").checked) ? "I" : "R", // i 즉시 R 예약
            reserveTime: document.getElementById("send-reserve-date").value + " " + document.getElementById("send-reserve-time").value,
            mpCode: mpCode,
            pushData: null,
            useWebLink: document.getElementById("use-web-link").checked,
            webLink: document.getElementById("web-link").value,
            usePush: false,
            kakaoTemplate: "",
            kakaoText: document.getElementById("kakao-text").value,
            RCSText: "",
            SMSText: getSMSText()
        }
        const msgType = "FT";
        const groups = document.querySelectorAll("input[name='groupCheck']:checked");
        let target = [];
        for (group of groups) {
            target.push(`'${group.value}'`);
        }
        let targetGroups = target.join(",");

        if (!validation(msgData.kakaoText, targetGroups, msgData.sendType, msgData.reserveTime)) return;

        // const modal_sendProcess = new bootstrap.Modal(document.getElementById('modal-sendProcess'));
        // modal_sendProcess.show();

        // let callApi = `${apiServer}/message/apiSendRCS`;
        let callApi = `${apiServer}/push/apiSend`;
        await axios.post(callApi, {
            store_code: '<%=user.store_code %>',
            msgType: msgType,
            msgData: JSON.stringify(msgData),
            targetGroups: targetGroups
        }, {
            headers: {
                xtoken: getCookie("xToken")
            }
        }).then(response => {
            // console.log(response)
            // setTimeout(function() {
            //     let modal_sendProcess = bootstrap.Modal.getInstance(document.getElementById('modal-sendProcess'));
            //     modal_sendProcess.hide();
            // }, 1000)

            if (response.data.result && response.data.data.returnCode == 0) {
                if (msgData.sendType == "I") {
                    alert(`친구톡이 발송되었습니다.`);
                } else {
                    alert(`친구톡 발송이 예약되었습니다. 예약된 친구톡은 발송 내역에서 취소할 수 있습니다.`);
                }
            } else {
                alert(`친구톡 발송이 실패했습니다: ${response.data.data.returnMessage}`);
            }
        })
        .catch(error => { 
            // setTimeout(function() {
            //     let modal_sendProcess = bootstrap.Modal.getInstance(document.getElementById('modal-sendProcess'));
            //     modal_sendProcess.hide();
            // }, 1000)

            console.log(error); 
            alert(`친구톡 발송에 실패했습니다.`);
        });
    }
</script>